function getPostcodeArea(value) {
  if (!value) return null;
  const str = String(value).trim().toUpperCase();
  // Match outward postcode like CA11, N1, SW1A anywhere in the string
  const m = str.match(/\b([A-Z]{1,2}\d[A-Z\d]?)\b/);
  return m ? m[1] : null;
}


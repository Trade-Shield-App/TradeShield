function getInitialsFromText(txt) {
  const parts = String(txt||'T').trim().split(/\s+/).filter(Boolean);
  if (!parts.length) return 'T';
  return (parts[0][0] + (parts[1]?.[0] || '')).toUpperCase();
}

function normaliseJob(job) {
  const tradeName = job.tradeName || job.trade_name || (job.tradesperson_name) || job.trade || 'TradeShield';
  const tradeAv = job.tradeAv || job.trade_av || getInitialsFromText(tradeName);
  return {
    ...job,
    tradeName,
    tradeAv,
    tradeCls: job.tradeCls || job.trade_cls || 'av-ai',
    cert: job.cert || job.cert_scheme || '',
    milestonesDone: Number(job.milestonesDone ?? job.milestones_done ?? job.milestonesdone ?? 0) || 0,
    pendingReview: !!(job.pendingReview ?? job.pending_review ?? false),
    escrow: Number(job.escrow || 0) || 0,
    paid: Number(job.paid || 0) || 0,
    progress: Number(job.progress || 0) || 0,
    milestones: Array.isArray(job.milestones) ? job.milestones : (job.milestones ? job.milestones : ['Completion'])
  };
}


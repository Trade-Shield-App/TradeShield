const SIZE_MUL = { 'Studio / 1-bed': 0.75, '2-bed flat': 0.9, '3-bed semi': 1, '4+ bed detached': 1.35 };

function calcEst() {
  const trade = document.getElementById('est-trade')?.value || 'Electrician';
  const job   = document.getElementById('est-job')?.value   || 'Major Job / Full Install';
  const size  = document.getElementById('est-size')?.value  || '3-bed semi';
  const base  = EST_DATA[trade]?.[job] || [300,500,800];
  const mul   = SIZE_MUL[size] || 1;
  const rate  = LOCALES[currentLocale]?.rate || 1;
  const s     = sym();
  const [lo, mid, hi] = base.map(v => s + Math.round(v * mul * rate).toLocaleString());
  const el = document.getElementById('est-result');
  if (el) el.innerHTML = `
    <div class="calc-row"><span style="color:var(--tx3)">Low estimate</span><span style="color:var(--green)">${lo}</span></div>
    <div class="calc-row"><span style="color:var(--tx3)">Average estimate</span><span style="color:var(--gold)">${mid}</span></div>
    <div class="calc-row"><span style="color:var(--tx3)">High estimate</span><span style="color:var(--red)">${hi}</span></div>

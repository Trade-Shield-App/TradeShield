function renderMessages() {
  renderConvList();
  const hasConvs = Object.keys(messages).length > 0;
  const chatHead = document.getElementById('chat-head');
  const chatBody = document.getElementById('chat-body');
  const msgInputRow = document.getElementById('msg-input-row');
  if (!hasConvs) {
    if (chatHead) chatHead.style.display = 'none';
    if (msgInputRow) msgInputRow.style.display = 'none';
    if (chatBody) {
      chatBody.style.display = 'flex';
      chatBody.innerHTML = '<div style="text-align:center;color:var(--tx3)"><div style="font-size:1.8rem;margin-bottom:8px">💬</div><div style="font-size:.82rem">No conversations yet</div><div style="font-size:.74rem;margin-top:4px">Book a trade to start messaging</div></div>';
    }
    return;
  }
  const d = messages[currentChatName];
  if (!d) return;
  if (chatHead) chatHead.style.display = '';
  if (msgInputRow) msgInputRow.style.display = '';
  if (chatBody) { chatBody.style.display = 'flex'; chatBody.style.flexDirection = 'column'; chatBody.style.alignItems = ''; chatBody.style.justifyContent = ''; }
  document.getElementById('chat-av').textContent = d.av;
  document.getElementById('chat-av').className = 'av av-sm '+d.cls;
  document.getElementById('chat-name').textContent = currentChatName;
  document.getElementById('chat-job').textContent = d.job||'';
  chatBody.innerHTML = d.msgs.map(m=>`<div class="bubble ${m.t}">${m.m}</div>`).join('');
  chatBody.scrollTop = chatBody.scrollHeight;
  document.getElementById('msg-in').placeholder = 'Message '+currentChatName+'…';
}

function selectChat(name, el) {
  currentChatName = name;
  document.querySelectorAll('.msg-item').forEach(i=>i.classList.remove('active'));
  if(el) el.classList.add('active');
  renderMessages();
}

async function sendMsg(e) {
  if (e.key!=='Enter'&&e.type!=='click') return;
  const inp = document.getElementById('msg-in');
  const txt = inp.value.trim(); if (!txt) return;
  inp.value = '';
  if (!messages[currentChatName]) messages[currentChatName]={av:'?',cls:'av-mike',job:'',msgs:[]};
  messages[currentChatName].msgs.push({t:'sent',m:txt});
  renderMessages();
  if (SB_READY) {
    const job = jobs.find(j=>j.tradeName===currentChatName||j.clientName===currentChatName);
    if (job) await sb.from('messages').insert({job_id:job.id,sender_id:currentUser.id,recipient_name:currentChatName,text:txt});
  } else {
    DB.set('msgs_'+currentUser.id, messages);
    const body=document.getElementById('chat-body');
    const tEl=document.createElement('div'); tEl.className='typing';
    tEl.innerHTML='<div class="tdot"></div><div class="tdot"></div><div class="tdot"></div>';
    body.appendChild(tEl); body.scrollTop=body.scrollHeight;
    const replies=["Got it, thanks! 👍","Understood, will do.","Thanks for the update!","I'll send photos when done.","On my way — ETA 15 mins. 🚗","Perfect, see you then!"];
    setTimeout(()=>{
      tEl.remove();
      messages[currentChatName].msgs.push({t:'recv',m:replies[Math.floor(Math.random()*replies.length)]});
      DB.set('msgs_'+currentUser.id,messages); renderMessages();
      toast('💬 New message from '+currentChatName);
    }, 1400);
  }
}


async function doAddEscrow() {
  const amt=parseFloat(document.getElementById('esc-amount').value);
  if(!amt||amt<1){showErr('esc-err','Enter a valid amount');return;}
  const jobId=document.getElementById('esc-job').value;
  if(SB_READY&&STRIPE_PK!=='YOUR_STRIPE_PK'){
    const btn=document.querySelector('#ov-addEscrow .btn-p');
    if(btn){btn.textContent='Processing…';btn.disabled=true;}
    try{
      const res=await fetch(FUNCTIONS_URL+'/create-payment',{method:'POST',headers:{'Authorization':'Bearer '+SUPABASE_KEY,'Content-Type':'application/json'},body:JSON.stringify({
        amount:amt,
        jobId,
        clientEmail:currentUser.email,
        tradeStripeAccountId:(jobs.find(j=>j.id===jobId)||{}).tradesperson_stripe_id||null,
        platformFeeAmount:Math.round(amt*0.025*100)/100
      })});
      const{clientSecret, paymentIntentId, error:fnErr}=await res.json();
      if(fnErr)throw new Error(fnErr);

      // Show card wrapper
      const cw2=document.getElementById('stripe-card-wrapper');
      if(cw2)cw2.style.display='block';
      const ph=document.getElementById('stripe-card-placeholder');
      if(ph)ph.style.display='none';

      // Use global Stripe instance — never recreate
      const stripe=getStripe();
      if(!stripe)throw new Error('Stripe not initialised');
      const card=getStripeCard();
      if(!card)throw new Error('Card element not ready');

      const{error:se}=await stripe.confirmCardPayment(clientSecret,{
        payment_method:{card, billing_details:{email:currentUser.email}}
      });
      if(se){toast('❌ '+se.message);return;}

      // *** SAVE PAYMENT INTENT ID TO JOB — needed for release on sign-off ***
      const job=jobs.find(j=>j.id===jobId);
      if(job){
        job.escrow=(job.escrow||0)+amt;
        job.status=job.status==='pending'?'active':job.status;
        job.stripe_payment_intent=paymentIntentId; // save this!
        if(SB_READY){
          await sb.from('jobs').update({
            escrow:job.escrow,
            status:job.status,
            stripe_payment_intent:paymentIntentId
          }).eq('id',jobId);
        }
      }
      await saveJobs();
      closeModal('addEscrow');
      toast('💰 £'+amt.toLocaleString()+' locked in escrow — insured instantly');
      renderAllPages();
    }catch(err){toast('❌ '+err.message);}
    finally{if(btn){btn.textContent='Add Funds';btn.disabled=false;}}
  } else {
    if(jobId){const job=jobs.find(j=>j.id===jobId);if(job){job.escrow=(job.escrow||0)+amt;job.status=job.status==='pending'?'active':job.status;}}
    await saveJobs();closeModal('addEscrow');
    const ins=(amt*0.015).toFixed(2);
    toast('💰 £'+amt.toLocaleString()+' added to escrow · £'+ins+' insurance'+(SB_READY?'':' (demo)'));
    renderAllPages();
  }
}


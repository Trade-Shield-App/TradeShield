        const { data:leadRows, error:leadErr } = await query;
        if (!leadErr) {
          tradeLeads = (leadRows || []).map(normaliseJob).filter(j => j.client_id !== currentUser.id);
        }
      } catch (e) {
        console.warn('Lead load skipped:', e);
        tradeLeads = [];
      }
    }


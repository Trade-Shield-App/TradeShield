function getDocs() { return DB.get('docs_'+currentUser.id, []); }
function saveDocs(d) { DB.set('docs_'+currentUser.id, d); }

function renderDocuments() {
  const el = document.getElementById('documents-list');
  if (!el) return;
  const docs = getDocs();

  // Populate property select
  const propSel = document.getElementById('ud-prop');
  if (propSel && propSel.options.length <= 1) {
    const props = typeof getProperties === 'function' ? getProperties() : [];
    props.forEach(p => {
      const opt = document.createElement('option');
      opt.value = p.id; opt.textContent = p.name;
      propSel.appendChild(opt);
    });
  }

  if (!docs.length) {
    el.innerHTML = `<div class="card" style="text-align:center;padding:44px">
      <div style="font-size:2.5rem;margin-bottom:12px">📁</div>
      <div style="font-family:'Fraunces',serif;font-size:1.1rem;margin-bottom:8px">No documents stored</div>
      <div style="font-size:.8rem;color:var(--tx3);margin-bottom:20px;max-width:360px;margin-left:auto;margin-right:auto">Upload certificates, contracts and reports. All stored securely against your account.</div>
      <button class="btn btn-p" onclick="openModal('uploadDoc')">＋ Upload Document</button>
    </div>`;
    return;
  }

  const now = new Date();
  el.innerHTML = docs.map(d => {
    const expiry = d.expiry ? new Date(d.expiry) : null;
    const daysUntil = expiry ? Math.round((expiry-now)/(1000*60*60*24)) : null;
    const isExpired = daysUntil !== null && daysUntil < 0;
    const isDueSoon = daysUntil !== null && daysUntil >= 0 && daysUntil <= 60;
    const statusCol = isExpired ? 'var(--red)' : isDueSoon ? 'var(--gold)' : 'var(--green)';
    const statusTxt = isExpired ? `Expired ${Math.abs(daysUntil)}d ago` : isDueSoon ? `Expires in ${daysUntil}d` : expiry ? `Valid until ${expiry.toLocaleDateString('en-GB')}` : 'No expiry';
    const icons = {'Gas Safety Certificate (CP12)':'🔥','EICR Electrical Report':'⚡','EPC Certificate':'🏠','Fire Risk Assessment':'🚒','HMO Licence':'📋','PAT Testing Certificate':'🔌','Boiler Service Record':'🔧','Building Regulations Certificate':'📐','Job Contract':'📝','Insurance Certificate':'🛡️','Other':'📄'};
    const icon = icons[d.type] || '📄';
    return `<div class="card" style="margin-bottom:9px">
      <div style="display:flex;align-items:center;gap:12px">
        <div style="width:42px;height:42px;background:var(--elevated);border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:1.3rem;flex-shrink:0">${icon}</div>
        <div style="flex:1;min-width:0">
          <div style="font-weight:600;font-size:.88rem">${d.name||d.type}</div>
          <div style="font-size:.7rem;color:var(--tx3)">${d.type}${d.propName?' · '+d.propName:''}</div>
          ${expiry ? `<div style="font-size:.7rem;color:${statusCol};margin-top:2px">${statusTxt}</div>` : ''}
          ${d.notes ? `<div style="font-size:.7rem;color:var(--tx3);margin-top:2px">${d.notes}</div>` : ''}
        </div>
        <div style="display:flex;flex-direction:column;gap:5px;flex-shrink:0">
          ${d.dataUrl ? `<button class="btn btn-s btn-xs" onclick="viewDoc('${d.id}')">👁 View</button>` : ''}
          <button class="btn btn-g btn-xs" onclick="deleteDoc('${d.id}')">🗑️</button>
        </div>
      </div>
    </div>`;
  }).join('');
}

function triggerDocUpload() { document.getElementById('ud-file').click(); }

function handleDocFile(input) {
  const file = input.files[0];
  if (!file) return;
  document.getElementById('ud-file-label').textContent = '✅ ' + file.name;
}

function doUploadDoc() {
  const type = document.getElementById('ud-type').value;
  const name = document.getElementById('ud-name').value.trim();
  const expiry = document.getElementById('ud-expiry').value;
  const notes = document.getElementById('ud-notes').value.trim();
  const propSel = document.getElementById('ud-prop');
  const propId = propSel?.value;
  const propName = propSel?.options[propSel.selectedIndex]?.text;
  const fileInput = document.getElementById('ud-file');
  const file = fileInput?.files[0];
  if (!type) { toast('⚠️ Select a document type'); return; }
  if (!name) { toast('⚠️ Give the document a name'); return; }

  const saveDoc = (dataUrl) => {
    const docs = getDocs();
    docs.unshift({
      id: 'd'+Date.now(), type, name, expiry, notes,
      propId: propId||null, propName: propId && propName !== 'Not property specific' ? propName : null,
      dataUrl: dataUrl||null,
      fileName: file?.name||null,
      addedAt: new Date().toISOString()
    });
    saveDocs(docs);
    closeModal('uploadDoc');
    ['ud-name','ud-expiry','ud-notes'].forEach(id=>{const e=document.getElementById(id);if(e)e.value='';});
    document.getElementById('ud-type').value='';
    if(propSel) propSel.value='';
    if(fileInput) fileInput.value='';
    document.getElementById('ud-file-label').textContent='Click to select file';
    toast('📁 Document saved');
    renderDocuments();
  };

  if (file) {
    const reader = new FileReader();
    reader.onload = e => saveDoc(e.target.result);
    reader.readAsDataURL(file);
  } else {
    saveDoc(null);
  }
}

function viewDoc(docId) {
  const doc = getDocs().find(d=>d.id===docId);
  if (!doc?.dataUrl) { toast('No file attached to this document'); return; }
  const win = window.open();
  win.document.write('<iframe src="'+doc.dataUrl+'" style="width:100%;height:100%;border:none"></iframe>');
}

function deleteDoc(docId) {
  if (!confirm('Delete this document?')) return;
  saveDocs(getDocs().filter(d=>d.id!==docId));
  renderDocuments();
  toast('🗑️ Document deleted');
}


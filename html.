// ══ HEALTH SCORE ══
function getHealthScore() {
  const props = getProperties();
  if (!props.length) return 100;
  const activeProps = props.filter(p=>p.active!==false);
  if (!activeProps.length) return 100;
  let totalScore = 0;
  activeProps.forEach(p => {
    let score = 100;
    const checks = p.checks || [];
    const now = new Date();
    checks.forEach(ch => {
      if (!ch.dueDate) return;
      const due = new Date(ch.dueDate);
      const daysUntil = Math.round((due-now)/(1000*60*60*24));
      if (daysUntil < 0) score -= 20; // overdue
      else if (daysUntil < 30) score -= 8; // due soon
    });
    totalScore += Math.max(0, score);
  });
  return Math.round(totalScore / activeProps.length);
}


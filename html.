  if(el('profile-about'))    el('profile-about').textContent    = currentUser.about||'';
  if(el('profile-location')) el('profile-location').textContent = currentUser.location||currentUser.postcode||'';
  if(el('profile-email'))    el('profile-email').textContent    = currentUser.email||'';
  if(el('profile-property')) el('profile-property').textContent = currentUser.property||currentUser.property_type||'';
  if(el('p-jobs-done'))      el('p-jobs-done').textContent      = completedJobs;

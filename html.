function calcPropScore(prop) {
  const checks = prop.checks || [];
  if (!checks.length) return 85;
  let score = 100;
  const now = new Date();
  checks.forEach(ch => {
    if (!ch.dueDate) return;
    const d = new Date(ch.dueDate);
    const days = Math.round((d - now) / (1000*60*60*24));
    if (days < 0) score -= 18;
    else if (days < 30) score -= 6;
    else if (days < 60) score -= 2;
  });
  return Math.max(0, Math.round(score));
}


function autoFillCheckInterval() {
  const sel = document.getElementById('ac-type');
  const opt = sel.options[sel.selectedIndex];
  const interval = opt?.dataset?.interval;
  const customWrap = document.getElementById('ac-custom-wrap');
 
  if (sel.value === 'custom') {
    customWrap.style.display = '';
    return;
  }
  customWrap.style.display = 'none';
 
  if (interval) {
    const lastEl = document.getElementById('ac-last');
    const dueEl = document.getElementById('ac-due');
    const lastDate = lastEl.value ? new Date(lastEl.value) : new Date();
    const dueDate = new Date(lastDate);
    dueDate.setDate(dueDate.getDate() + parseInt(interval));
    dueEl.value = dueDate.toISOString().split('T')[0];
  }
}


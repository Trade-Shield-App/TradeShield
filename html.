function bookRecurring(id) {
  const list = getRecurring();
  const r = list.find(x=>x.id===id);
  if (!r) return;
  // Mark next occurrence
  const days = FREQ_DAYS[r.freq] || 30;
  const next = new Date();
  next.setDate(next.getDate() + days);
  r.nextDate = next.toISOString();
  saveRecurring(list);
  renderRecurring();
  toast('📅 '+r.desc+' booked — next due '+next.toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric'}));
  openModal('bookTrade');
}

function deleteRecurring(id) {

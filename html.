// ══ SIGN OFF ══
let signOffJobId = null;
function openSignOff(jobId) {
  signOffJobId = jobId;
  const job = jobs.find(j=>j.id===jobId);
  if (!job) return;
  const nextMil = job.milestones?.[job.milestonesDone]||'Completion';
  const releaseAmt = Math.round(job.escrow / (job.milestones?.length - job.milestonesDone || 1));
  document.getElementById('signoff-details').innerHTML = `
    <div class="sum-row"><span style="color:var(--tx3)">Milestone</span><span class="sum-val">${nextMil}</span></div>
    <div class="sum-row"><span style="color:var(--tx3)">Releasing</span><span class="sum-val" style="color:var(--gold)">£${releaseAmt}</span></div>
    <div class="sum-row"><span style="color:var(--tx3)">To</span><span class="sum-val">${job.tradeName}</span></div>
    <div class="sum-row"><span style="color:var(--tx3)">Remaining</span><span class="sum-val">£${job.escrow-releaseAmt}</span></div>
  `;
  document.getElementById('signoff-confirm').value = '';
  openModal('signOff');
}

async function doSignOff() {
  const conf=document.getElementById('signoff-confirm').value.trim().toUpperCase();
  if(conf!=='CONFIRM'){toast('⚠️ Type CONFIRM to proceed');return;}
  const job=jobs.find(j=>j.id===signOffJobId);if(!job)return;
  const releaseAmt=Math.round(job.escrow*0.975);
  if(SB_READY){
    if(job.stripe_payment_intent){
      try{
        // Get tradesperson's connected Stripe account
        let tradeStripeAccountId = null;
        if(job.tradesperson_id && SB_READY){
          const{data:tradeUser}=await sb.from('users').select('stripe_account_id').eq('id',job.tradesperson_id).single();
          tradeStripeAccountId = tradeUser?.stripe_account_id || null;
        }
        const releaseRes=await fetch(FUNCTIONS_URL+'/release-payment',{
          method:'POST',
          headers:{'Authorization':'Bearer '+SUPABASE_KEY,'Content-Type':'application/json'},
          body:JSON.stringify({
            paymentIntentId: job.stripe_payment_intent,
            tradeStripeAccountId: tradeStripeAccountId
          })
        });
        const releaseData=await releaseRes.json();
        if(releaseData.error) throw new Error(releaseData.error);
        if(releaseData.autoSplit){
          toast('✅ £'+releaseData.tradespersonReceives+' sent to '+job.tradeName+' · You earned £'+releaseData.yourFee);
        } else {
          toast('✅ Released · Pay '+job.tradeName+' £'+releaseData.tradespersonReceives+' manually · Ref: '+job.ref);
        }
      } catch(e){
        console.error('Stripe release error:',e);
        toast('⚠️ Payment release failed: '+e.message);
      }
    } else {
      console.warn('No stripe_payment_intent on job — skipping Stripe release');
      toast('⚠️ No payment intent found — was escrow added via Stripe?');
    }
    await sb.from('jobs').update({status:'completed',progress:100,paid:releaseAmt,escrow:0,completed_at:new Date().toISOString()}).eq('id',signOffJobId);
    await sb.from('activity').insert({user_id:currentUser.id,text:`<strong>£${releaseAmt.toLocaleString()} released</strong> for ${job.title}`,color:'var(--green)',created_at:new Date().toISOString()});
  }
  job.status='completed';job.progress=100;job.paid=releaseAmt;job.escrow=0;job.pendingReview=true;
  job.milestonesDone=(job.milestones||[]).length;
  await saveJobs();closeModal('signOff');
  toast('✅ Signed off! £'+releaseAmt.toLocaleString()+' released to '+job.tradeName);
  renderAllPages();
}


let certRowCount = 0;

function updateCertOptions() {
  const trade    = document.getElementById('su-trade-type').value;
  const certWrap = document.getElementById('su-cert-wrap');
  const addBtn   = document.getElementById('su-add-cert-btn');
  const list     = document.getElementById('su-certs-list');

  if (!trade) {
    certWrap.style.display = 'none';
    certRowCount = 0;
    if (list) list.innerHTML = '';
    return;
  }

  certWrap.style.display = '';
  if (addBtn) addBtn.style.display = '';

  // Reset and add first row
  certRowCount = 0;
  if (list) list.innerHTML = '';
  addCertRow();
}

function addCertRow() {
  const trade = document.getElementById('su-trade-type').value;
  if (!trade) return;

  const list = document.getElementById('su-certs-list');
  if (!list) return;

  // Max 5 certifications
  if (certRowCount >= 5) {
    toast('Maximum 5 certifications — contact us if you need more');
    return;
  }

  certRowCount++;
  const idx = certRowCount;
  const schemes = CERT_SCHEMES[trade] || ['None/Other'];

  const row = document.createElement('div');
  row.id = `cert-row-${idx}`;
  row.style.cssText = 'background:var(--elevated);border:1px solid var(--bdr);border-radius:var(--rs);padding:11px 12px;position:relative';
  row.innerHTML = `
    ${idx > 1 ? `<button type="button" onclick="removeCertRow(${idx})" style="position:absolute;top:8px;right:8px;background:var(--red-d);border:1px solid rgba(255,77,109,.2);color:var(--red);border-radius:50%;width:20px;height:20px;font-size:.7rem;cursor:pointer;display:flex;align-items:center;justify-content:center;line-height:1">✕</button>` : ''}
    <div style="font-size:.7rem;font-weight:600;color:var(--tx3);text-transform:uppercase;letter-spacing:.06em;margin-bottom:7px">
      ${idx === 1 ? 'Primary Certification' : 'Additional Certification ' + idx}
    </div>
    <div style="margin-bottom:7px">
      <select class="fi" id="cert-scheme-${idx}" onchange="onCertSchemeChange(${idx})" style="margin-bottom:0">
        <option value="">Select scheme…</option>
        ${schemes.map(s=>`<option value="${s}">${s}</option>`).join('')}
      </select>
    </div>
    <div id="cert-reg-wrap-${idx}" style="display:none">
      <input type="text" class="fi" id="cert-reg-${idx}" placeholder="Registration number e.g. 123456" style="margin-bottom:0">
      <div class="err-msg" id="cert-reg-err-${idx}"></div>
    </div>
  `;
  list.appendChild(row);
}

function removeCertRow(idx) {
  const row = document.getElementById(`cert-row-${idx}`);
  if (row) { row.remove(); certRowCount--; }
}

function onCertSchemeChange(idx) {
  const scheme  = document.getElementById(`cert-scheme-${idx}`)?.value;
  const regWrap = document.getElementById(`cert-reg-wrap-${idx}`);
  if (regWrap) {
    regWrap.style.display = CERT_REQUIRES_NUMBER.includes(scheme) ? '' : 'none';
  }
}

function collectCertifications() {
  // Collect all cert rows into an array
  const certs = [];
  const list  = document.getElementById('su-certs-list');
  if (!list) return certs;

  const rows = list.querySelectorAll('[id^="cert-row-"]');
  rows.forEach(row => {
    const idx    = row.id.replace('cert-row-','');
    const scheme = document.getElementById(`cert-scheme-${idx}`)?.value || '';
    const reg    = document.getElementById(`cert-reg-${idx}`)?.value.trim() || '';
    if (scheme && scheme !== '') {
      certs.push({ scheme, reg_number: reg });
    }
  });
  return certs;
}

async function doSignup() {
  clearErrors();
  const first = document.getElementById('su-first').value.trim();
  const last  = document.getElementById('su-last').value.trim();
  const email = document.getElementById('su-email').value.trim();
  const pass  = document.getElementById('su-pass').value;
  const role  = document.getElementById('role-client').classList.contains('selected') ? 'client' : 'trade';

  if (!first) { showErr('su-first-err','Required'); return; }
  if (!last)  { showErr('su-last-err','Required'); return; }
  if (!email.includes('@')) { showErr('su-email-err','Valid email required'); return; }
  if (pass.length < 8) { showErr('su-pass-err','Min 8 characters'); return; }

  // Trader-specific validation
  let tradeType='', exp='', rate='', certifications=[];
  if (role === 'trade') {
    tradeType = document.getElementById('su-trade-type')?.value || '';
    exp       = document.getElementById('su-exp')?.value || '';
    rate      = document.getElementById('su-rate')?.value.trim() || '';
    if (!tradeType) { showErr('su-err','Please select your trade type'); return; }

    // Collect and validate all cert rows
    certifications = collectCertifications();
    let certValid = true;
    certifications.forEach((c, i) => {
      const idx = i + 1;
      if (CERT_REQUIRES_NUMBER.includes(c.scheme) && !c.reg_number) {
        const errEl = document.getElementById(`cert-reg-err-${idx}`);

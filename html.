function getLeadById(leadId) {
  return (tradeLeads || []).find(j => String(j.id) === String(leadId)) || null;
}

function ensureQuoteRequestFromLead(leadId) {
  const lead = getLeadById(leadId);
  if (!lead) return null;
  const quotes = getQuotes();
  let existing = quotes.find(q => q.sourceLeadId && String(q.sourceLeadId) === String(leadId));
  if (existing) return existing;

  existing = {
    id: 'leadqr_' + leadId,
    sourceLeadId: String(leadId),
    title: lead.title || ((lead.trade || 'General') + ' job'),
    trade: lead.trade || lead.trade_type || 'General',
    desc: lead.description || lead.desc || 'Client lead ready for quote.',
    budget: lead.budget || lead.hourly_rate || '',
    date: lead.date || lead.preferred_date || '',
    address: lead.postcode || lead.location || lead.area || '',
    status: 'open',
    quotes: [],
    clientId: lead.client_id || lead.user_id || '',
    clientName: lead.client_name || 'Client',
    createdAt: lead.created_at || new Date().toISOString()
  };

  quotes.unshift(existing);
  saveQuotes(quotes);
  return existing;
}

function openLeadQuote(leadId) {
  const quoteRequest = ensureQuoteRequestFromLead(leadId);
  if (!quoteRequest) {
    toast('⚠️ That lead could not be opened right now');

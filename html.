}

let currentQuoteId = null;
function openSubmitQuote(qid) {
  currentQuoteId = qid;
  const quotes = getQuotes();
  const q = quotes.find(x=>x.id===qid);
  if (!q) return;
  const titleEl = document.getElementById('sq-job-title');
  const detailEl = document.getElementById('sq-job-details');
  if (titleEl) titleEl.textContent = q.title;
  if (detailEl) detailEl.innerHTML = `<strong>${q.trade}</strong> · ${q.address||'Location TBC'}<br>${q.desc}${q.budget?`<br><span style="color:var(--gold)">Client budget: £${q.budget}</span>`:''}`;
  ['sq-amount','sq-duration','sq-includes','sq-start'].forEach(id=>{const e=document.getElementById(id);if(e)e.value='';});
  openModal('submitQuote');
}

async function doSubmitQuote() {
  if (gateQuoteSubmit()) return;
  const amount = document.getElementById('sq-amount').value;
  const duration = document.getElementById('sq-duration').value.trim();
  const includes = document.getElementById('sq-includes').value.trim();
  const startDate = document.getElementById('sq-start').value;
  if (!amount) { toast('⚠️ Enter your quote amount'); return; }
  if (!includes) { toast('⚠️ Describe what is included'); return; }
  const quotes = getQuotes();
  const q = quotes.find(x=>x.id===currentQuoteId);
  if (!q) { toast('⚠️ That quote request could not be found'); return; }
  q.quotes = q.quotes || [];
  if (q.quotes.length >= 3) { toast('⚠️ This job already has 3 quotes'); return; }
  if (q.quotes.find(qu=>qu.tradeId===currentUser.id)) { toast('⚠️ You already quoted on this job'); return; }

  const quotePayload = {
    tradeId: currentUser.id,
    tradeName: currentUser.name,
    amount,
    duration,
    includes,
    startDate: startDate||new Date().toISOString(),
    submittedAt: new Date().toISOString()
  };
  q.quotes.push(quotePayload);
  q.status = q.quotes.length ? 'quoted' : (q.status || 'open');
  saveQuotes(quotes);

  if (q.sourceLeadId) {
    const lead = (tradeLeads || []).find(j => String(j.id) === String(q.sourceLeadId));
    if (lead) lead.status = 'quoted';
  }

  closeModal('submitQuote');
  toast('✅ Quote submitted successfully');
  renderQuotes();
  if (typeof renderAllPages === 'function') renderAllPages();
}

async function acceptQuote(qid, tradeId) {
  const quotes = getQuotes();
  const q = quotes.find(x=>x.id===qid);
  if (!q) { toast('⚠️ Quote request not found'); return; }

  const acceptedQuote = (q.quotes || []).find(qu => qu.tradeId === tradeId);
  if (!acceptedQuote) { toast('⚠️ Selected quote not found'); return; }

  q.status = 'accepted';
  q.acceptedTradeId = tradeId;
  q.quotes.forEach(qu => qu.accepted = qu.tradeId === tradeId);
  saveQuotes(quotes);

  const acceptedTrade = TRADES_DATA.find(t => String(t.id) === String(tradeId)) || {};
  let linkedJob = null;

  if (q.sourceLeadId) {
    linkedJob = jobs.find(j => String(j.id) === String(q.sourceLeadId)) || null;
  }

  if (!linkedJob) {
    linkedJob = {
      id: q.sourceLeadId || ('qjob_' + Date.now()),
      title: q.title,
      trade: q.trade,
      description: q.desc,
      client_id: q.clientId || (currentUser && currentUser.id) || '',
      status: 'active',
      escrow: 0,
      progress: 5,
      ref: 'TS-' + Math.floor(2900 + Math.random() * 100),
      milestones: ['Completion'],
      milestonesDone: 0,
      date: q.date || new Date().toISOString().split('T')[0],
      address: q.address || '',
      postcode: q.address || '',
      budget: Number(String(acceptedQuote.amount).replace(/[^0-9.]/g,'')) || q.budget || 0,
      created_at: q.createdAt || new Date().toISOString()
    };
    jobs.unshift(linkedJob);
  }

  linkedJob.status = 'active';
  linkedJob.progress = Math.max(Number(linkedJob.progress || 0), 5);
  linkedJob.tradeName = acceptedQuote.tradeName || acceptedTrade.name || linkedJob.tradeName || 'Tradesperson';
  linkedJob.trade_name = linkedJob.tradeName;
  linkedJob.tradesperson_id = tradeId;
  linkedJob.quote_amount = Number(String(acceptedQuote.amount).replace(/[^0-9.]/g,'')) || linkedJob.quote_amount || 0;
  linkedJob.accepted_quote_amount = linkedJob.quote_amount;
  linkedJob.quote_request_id = q.id;
  linkedJob.start_date = acceptedQuote.startDate || linkedJob.start_date || null;

  if (SB_READY && linkedJob.id) {
    try {
      await sb.from('jobs').update({
        status: linkedJob.status,
        progress: linkedJob.progress,
        trade_name: linkedJob.tradeName,
        tradesperson_id: linkedJob.tradesperson_id,
        quote_amount: linkedJob.quote_amount,
        accepted_quote_amount: linkedJob.accepted_quote_amount,
        quote_request_id: linkedJob.quote_request_id,
        start_date: linkedJob.start_date
      }).eq('id', linkedJob.id);
    } catch (e) {
      console.warn('Quote acceptance sync skipped:', e);
    }
  }

  await saveJobs();
  toast('🎉 Quote accepted. You can now fund escrow to confirm the booking.');
  renderQuotes();
  if (typeof renderAllPages === 'function') renderAllPages();
  if (typeof navigate === 'function') navigate('escrow');
}


<style>
:root{
  --bg:#07080a;--card:#0e1014;--elevated:#14171d;--hover:#1a1e26;
  --gold:#d4a843;--gold-l:#e8c46a;--gold-dim:rgba(212,168,67,.15);--gold-b:rgba(212,168,67,.28);
  --tx:#f0ede8;--tx2:#8a8f9a;--tx3:#4a4f5a;
  --bdr:rgba(255,255,255,.07);--bdr2:rgba(255,255,255,.12);
  --green:#3ecf8e;--green-d:rgba(62,207,142,.12);
  --red:#ff4d6d;--red-d:rgba(255,77,109,.12);
  --blue:#4d9fff;--purple:#a855f7;
  --r:14px;--rs:8px;--sw:256px;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{font-size:15px;height:100%}
body{background:var(--bg);color:var(--tx);font-family:'Satoshi',sans-serif;min-height:100vh;overflow-x:hidden}
body::before{content:'';position:fixed;inset:0;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='https://emea01.safelinks.protection.outlook.com/?url=http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%27%253E%253Cfilter&data=05%7C02%7C%7Ce7c632342fa14c0db00208ded547b511%7C84df9e7fe9f640afb435aaaaaaaaaaaa%7C1%7C0%7C639182701125369055%7CUnknown%7CTWFpbGZsb3d8eyJFbXB0eU1hcGkiOnRydWUsIlYiOiIwLjAuMDAwMCIsIlAiOiJXaW4zMiIsIkFOIjoiTWFpbCIsIldUIjoyfQ%3D%3D%7C0%7C%7C%7C&sdata=FIJ5XZXZvSICacYUmFwkFLXgPSZfEdPSsLy9QZjuEUA%3D&reserved=0 id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.04'/%3E%3C/svg%3E");pointer-events:none;z-index:9999;opacity:.45}

/* AUTH */
#auth-screen{position:fixed;inset:0;background:var(--bg);z-index:500;display:flex;align-items:center;justify-content:center;padding:20px;overflow-y:auto;-webkit-overflow-scrolling:touch}
.auth-box{background:var(--card);border:1px solid var(--bdr);border-radius:20px;width:100%;max-width:440px;padding:36px;position:relative;overflow-y:auto;overflow-x:hidden;max-height:calc(100vh - 40px);-webkit-overflow-scrolling:touch}
.auth-box::before{content:'';position:absolute;top:0;left:10%;right:10%;height:1px;background:linear-gradient(90deg,transparent,rgba(255,255,255,.15),transparent)}
.auth-logo{display:flex;align-items:center;gap:10px;margin-bottom:28px;justify-content:center}
.auth-logo-mark{width:40px;height:40px;background:linear-gradient(135deg,var(--gold),#b8832a);border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:20px;box-shadow:0 0 20px rgba(212,168,67,.35)}
.auth-logo-text{font-family:'Fraunces',serif;font-size:1.4rem;font-weight:600}
.auth-logo-text span{color:var(--gold)}
.auth-tabs{display:flex;background:var(--elevated);border-radius:var(--rs);padding:3px;margin-bottom:24px}
.auth-tab{flex:1;padding:9px;text-align:center;border-radius:6px;font-size:.83rem;font-weight:500;cursor:pointer;color:var(--tx2);transition:all .2s}
.auth-tab.active{background:var(--card);color:var(--tx);box-shadow:0 1px 4px rgba(0,0,0,.4)}
.auth-role-pick{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:16px}
.role-card{background:var(--elevated);border:2px solid var(--bdr);border-radius:var(--rs);padding:14px;text-align:center;cursor:pointer;transition:all .2s}
.role-card:hover{border-color:var(--gold-b)}
.role-card.selected{border-color:var(--gold);background:var(--gold-dim)}
.role-emoji{font-size:1.8rem;display:block;margin-bottom:5px}
.role-label{font-size:.8rem;font-weight:600}
.role-sub{font-size:.68rem;color:var(--tx3);margin-top:2px}
.demo-accounts{background:var(--elevated);border-radius:var(--rs);padding:12px;margin-bottom:16px}
.demo-acc{display:flex;align-items:center;gap:9px;padding:7px 8px;border-radius:6px;cursor:pointer;transition:background .15s}
.demo-acc:hover{background:var(--hover)}
.demo-acc-info{flex:1;font-size:.76rem}
.demo-acc-name{font-weight:600;color:var(--tx)}
.demo-acc-email{color:var(--tx3)}

/* LAYOUT */
.app{display:none;min-height:100vh}
.app.visible{display:flex}
.sidebar{width:var(--sw);background:var(--card);border-right:1px solid var(--bdr);display:flex;flex-direction:column;position:fixed;top:0;left:0;bottom:0;z-index:100;transition:transform .3s}
.sidebar-logo{padding:22px 18px 18px;border-bottom:1px solid var(--bdr);display:flex;align-items:center;gap:9px}
.logo-mark{width:34px;height:34px;background:linear-gradient(135deg,var(--gold),#b8832a);border-radius:9px;display:flex;align-items:center;justify-content:center;font-size:17px;box-shadow:0 0 16px rgba(212,168,67,.3);flex-shrink:0}
.logo-text{font-family:'Fraunces',serif;font-size:1.1rem;font-weight:600}
.logo-text span{color:var(--gold)}
.logo-badge{font-size:.58rem;background:var(--gold-dim);color:var(--gold);border:1px solid var(--gold-b);border-radius:4px;padding:1px 5px;margin-left:3px}
.sidebar-nav{flex:1;padding:10px 9px;display:flex;flex-direction:column;gap:1px;overflow-y:auto}
.nav-sec{font-size:.6rem;color:var(--tx3);text-transform:uppercase;letter-spacing:.1em;padding:9px 9px 3px}
.nav-item{display:flex;align-items:center;gap:10px;padding:8px 10px;border-radius:var(--rs);cursor:pointer;transition:all .2s;color:var(--tx2);font-size:.82rem;font-weight:500;position:relative;user-select:none}
.nav-item:hover{background:var(--hover);color:var(--tx)}
.nav-item.active{background:var(--gold-dim);color:var(--gold)}
.nav-item.active::before{content:'';position:absolute;left:0;top:20%;bottom:20%;width:3px;background:var(--gold);border-radius:0 3px 3px 0}
.nav-icon{font-size:.95rem;width:17px;text-align:center;flex-shrink:0}
.nav-badge{margin-left:auto;background:var(--gold);color:var(--bg);font-size:.6rem;font-weight:700;padding:2px 5px;border-radius:20px;min-width:18px;text-align:center}
.nav-badge.red{background:var(--red)}
.sidebar-footer{margin:0 9px;padding:10px;background:var(--elevated);border-radius:var(--rs);border:1px solid var(--bdr);display:flex;align-items:center;gap:9px;cursor:pointer;transition:border-color .2s}
.sidebar-footer:hover{border-color:var(--gold-b)}

/* MAIN */
.main{margin-left:var(--sw);flex:1;display:flex;flex-direction:column;min-height:100vh}
.topbar{background:rgba(14,16,20,.88);backdrop-filter:blur(14px);border-bottom:1px solid var(--bdr);padding:0 26px;height:60px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:50}
.topbar-title{font-family:'Fraunces',serif;font-size:1.2rem;font-weight:600}
.topbar-right{display:flex;align-items:center;gap:9px}
.tbtn{height:34px;padding:0 11px;background:var(--elevated);border:1px solid var(--bdr);border-radius:var(--rs);display:flex;align-items:center;gap:5px;cursor:pointer;font-size:.78rem;color:var(--tx2);transition:all .2s;font-family:'Satoshi',sans-serif;white-space:nowrap}
.tbtn:hover{background:var(--hover);color:var(--tx);border-color:var(--bdr2)}
.tbtn.gold{background:linear-gradient(135deg,var(--gold),#b8832a);color:var(--bg);border:none;font-weight:600}
.tbtn.gold:hover{box-shadow:0 4px 14px rgba(212,168,67,.4)}
.page{padding:24px;animation:fi .28s ease;display:none}
.page.active{display:block!important}
@keyframes fi{from{opacity:0;transform:translateY(7px)}to{opacity:1;transform:translateY(0)}}

/* SUBSCRIPTION PLAN CARDS */
.sub-plan-card{background:var(--elevated);border:2px solid var(--bdr);border-radius:var(--rs);padding:14px;cursor:pointer;transition:all .2s;position:relative}
.sub-plan-card:hover{border-color:var(--gold-b)}
.sub-plan-card.active{border-color:var(--gold);background:var(--gold-dim)}
.sub-plan-card.sub-plan-popular{border-color:var(--gold-b)}
.sub-plan-badge{font-size:.55rem;background:var(--gold);color:var(--bg);border-radius:4px;padding:1px 5px;display:inline-block;margin-bottom:5px;font-weight:700;letter-spacing:.05em}
.sub-plan-name{font-weight:700;font-size:.85rem;margin-bottom:3px}
.sub-plan-price{font-family:'Fraunces',serif;font-size:1.3rem;font-weight:600;margin-bottom:8px}
.sub-plan-features{display:flex;flex-direction:column;gap:3px;font-size:.67rem;color:var(--tx2)}
.sub-upgrade-box{background:linear-gradient(135deg,rgba(212,168,67,.1),rgba(212,168,67,.03));border:1px solid var(--gold-b);border-radius:var(--rs);padding:12px 14px;display:flex;align-items:center;justify-content:space-between;gap:10px}
.sub-gate-overlay{position:absolute;inset:0;background:rgba(7,8,10,.82);border-radius:var(--r);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;backdrop-filter:blur(3px);z-index:10;cursor:pointer}
.sub-gate-overlay .lock-icon{font-size:1.8rem}
.sub-gate-overlay .lock-txt{font-size:.78rem;font-weight:600;color:var(--tx)}
.sub-gate-overlay .lock-sub{font-size:.7rem;color:var(--tx3);text-align:center}
.sub-gate-overlay .lock-btn{margin-top:4px}
.bnav{display:none;position:fixed;bottom:0;left:0;right:0;background:var(--card);border-top:1px solid var(--bdr);z-index:100;padding:5px 0 max(5px,env(safe-area-inset-bottom))}
.bnav-items{display:flex}
.bnav-item{flex:1;display:flex;flex-direction:column;align-items:center;gap:3px;padding:5px 2px;cursor:pointer;color:var(--tx3);font-size:.56rem;font-weight:500;transition:color .2s;position:relative}
.bnav-item .nav-icon{font-size:1.1rem;width:auto}
.bnav-item.active{color:var(--gold)}
.bnav-item.active::after{content:'';position:absolute;bottom:-5px;left:50%;transform:translateX(-50%);width:26px;height:2px;background:var(--gold);border-radius:2px}

/* CARDS */
.card{background:var(--card);border-radius:var(--r);border:1px solid var(--bdr);padding:20px;position:relative;overflow:hidden}
.card::before{content:'';position:absolute;top:0;left:10%;right:10%;height:1px;background:linear-gradient(90deg,transparent,rgba(255,255,255,.1),transparent)}
.card-hover{cursor:pointer;transition:all .2s}
.card-hover:hover{border-color:var(--gold-b);transform:translateY(-2px)}

/* STATS */
.stats-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:13px;margin-bottom:20px}
.stat{background:var(--card);border:1px solid var(--bdr);border-radius:var(--r);padding:16px 18px;position:relative;overflow:hidden}
.stat::before{content:'';position:absolute;top:0;left:10%;right:10%;height:1px;background:linear-gradient(90deg,transparent,rgba(255,255,255,.1),transparent)}
.stat-lbl{font-size:.7rem;color:var(--tx3);text-transform:uppercase;letter-spacing:.08em;margin-bottom:5px}
.stat-val{font-family:'Fraunces',serif;font-size:1.65rem;font-weight:600}
.stat-val.g{color:var(--gold)}
.stat-val.gr{color:var(--green)}
.stat-sub{font-size:.68rem;color:var(--tx3);margin-top:3px}
.stat-icon{position:absolute;top:16px;right:16px;font-size:1.2rem;opacity:.22}

/* GRIDS */
.g2{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.g3{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
.g4{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
.sec-title{font-family:'Fraunces',serif;font-size:1rem;font-weight:600;margin-bottom:12px}
.sec-hdr{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px}
.see-all{font-size:.74rem;color:var(--gold);cursor:pointer}
.see-all:hover{text-decoration:underline}

/* BADGES */
.badge{display:inline-flex;align-items:center;gap:4px;padding:2px 8px;border-radius:20px;font-size:.66rem;font-weight:600}
.bg{background:var(--gold-dim);color:var(--gold);border:1px solid var(--gold-b)}
.bgr{background:var(--green-d);color:var(--green);border:1px solid rgba(62,207,142,.2)}
.br{background:var(--red-d);color:var(--red);border:1px solid rgba(255,77,109,.2)}
.bb{background:rgba(77,159,255,.12);color:var(--blue);border:1px solid rgba(77,159,255,.2)}
.bp{background:rgba(168,85,247,.12);color:var(--purple);border:1px solid rgba(168,85,247,.2)}
.bx{background:rgba(255,255,255,.04);color:var(--tx3);border:1px solid var(--bdr)}
.ldot{width:5px;height:5px;background:var(--green);border-radius:50%;animation:blink 1.5s infinite}
@keyframes blink{0%,100%{opacity:1}50%{opacity:.3}}

/* BUTTONS */
.btn{display:inline-flex;align-items:center;gap:6px;padding:8px 16px;border-radius:var(--rs);font-family:'Satoshi',sans-serif;font-size:.8rem;font-weight:600;cursor:pointer;border:none;transition:all .2s;user-select:none;white-space:nowrap}
.btn-p{background:linear-gradient(135deg,var(--gold),#b8832a);color:var(--bg);box-shadow:0 3px 12px rgba(212,168,67,.25)}
.btn-p:hover{box-shadow:0 5px 20px rgba(212,168,67,.45);transform:translateY(-1px)}
.btn-s{background:var(--elevated);color:var(--tx);border:1px solid var(--bdr2)}
.btn-s:hover{background:var(--hover);border-color:var(--gold-b)}
.btn-g{background:transparent;color:var(--tx2);border:1px solid var(--bdr)}
.btn-g:hover{border-color:var(--bdr2);color:var(--tx)}
.btn-d{background:var(--red-d);color:var(--red);border:1px solid rgba(255,77,109,.2)}
.btn-gr{background:var(--green-d);color:var(--green);border:1px solid rgba(62,207,142,.2)}
.btn-sm{padding:5px 11px;font-size:.73rem}
.btn-xs{padding:3px 8px;font-size:.67rem}
.btn-full{width:100%;justify-content:center}

/* ESCROW BAR */
.ebar{height:7px;background:rgba(255,255,255,.06);border-radius:100px;overflow:visible;position:relative}
.efill{height:100%;border-radius:100px;background:linear-gradient(90deg,#b8832a,var(--gold),var(--gold-l));box-shadow:0 0 10px rgba(212,168,67,.45);position:relative;transition:width 1s ease}
.edot{position:absolute;right:-5px;top:50%;transform:translateY(-50%);width:12px;height:12px;background:var(--gold);border-radius:50%;box-shadow:0 0 10px var(--gold);animation:pdot 2s ease-in-out infinite}
@keyframes pdot{0%,100%{box-shadow:0 0 6px var(--gold)}50%{box-shadow:0 0 14px var(--gold),0 0 28px rgba(212,168,67,.6)}}

/* FORMS */
.fg{margin-bottom:13px}
.fl{font-size:.72rem;font-weight:600;color:var(--tx2);text-transform:uppercase;letter-spacing:.06em;margin-bottom:4px;display:block}
.fi{width:100%;background:var(--elevated);border:1px solid var(--bdr);border-radius:var(--rs);padding:8px 12px;font-family:'Satoshi',sans-serif;font-size:.83rem;color:var(--tx);outline:none;transition:border-color .2s}
.fi:focus{border-color:var(--gold-b)}
.fi::placeholder{color:var(--tx3)}
select.fi{cursor:pointer}
textarea.fi{resize:vertical;min-height:72px}
.fi-err{border-color:var(--red)!important}
.err-msg{font-size:.7rem;color:var(--red);margin-top:3px}

/* JOB CARDS */
.job-card{background:var(--card);border:1px solid var(--bdr);border-radius:var(--r);padding:16px;margin-bottom:9px;position:relative;overflow:hidden;transition:border-color .2s}
.job-card::before{content:'';position:absolute;top:0;left:10%;right:10%;height:1px;background:linear-gradient(90deg,transparent,rgba(255,255,255,.1),transparent)}
.job-card:hover{border-color:var(--bdr2)}
.jc-row{display:flex;align-items:flex-start;justify-content:space-between;gap:10px;margin-bottom:10px}
.j-title{font-weight:600;font-size:.9rem}
.j-meta{font-size:.7rem;color:var(--tx3);margin-top:2px}
.j-actions{display:flex;gap:6px;margin-top:10px;flex-wrap:wrap}

/* TABS */
.tabs{display:flex;gap:3px;background:var(--elevated);border-radius:var(--rs);padding:3px;margin-bottom:16px;width:fit-content;flex-wrap:wrap}
.tab{padding:6px 13px;border-radius:5px;font-size:.78rem;font-weight:500;cursor:pointer;color:var(--tx2);transition:all .2s;white-space:nowrap}
.tab.active{background:var(--card);color:var(--tx);box-shadow:0 1px 4px rgba(0,0,0,.35)}

/* MESSAGES */
.msg-wrap{display:grid;grid-template-columns:250px 1fr;background:var(--card);border:1px solid var(--bdr);border-radius:var(--r);overflow:hidden;height:520px}
.msg-list{border-right:1px solid var(--bdr);overflow-y:auto;display:flex;flex-direction:column}
.msg-item{padding:11px 13px;border-bottom:1px solid var(--bdr);cursor:pointer;transition:background .15s;display:flex;gap:8px;align-items:flex-start}
.msg-item:hover{background:var(--hover)}
.msg-item.active{background:var(--gold-dim)}
.msg-name{font-size:.8rem;font-weight:600;margin-bottom:2px}
.msg-prev{font-size:.7rem;color:var(--tx3);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:150px}
.msg-time{font-size:.62rem;color:var(--tx3);flex-shrink:0}
.msg-chat{display:flex;flex-direction:column}
.msg-ch-head{padding:13px 16px;border-bottom:1px solid var(--bdr);display:flex;align-items:center;gap:10px}
.msg-body{flex:1;overflow-y:auto;padding:14px;display:flex;flex-direction:column;gap:9px}
.bubble{max-width:72%;padding:8px 12px;border-radius:13px;font-size:.78rem;line-height:1.55}
.bubble.sent{background:var(--gold-dim);border:1px solid var(--gold-b);color:var(--tx);margin-left:auto;border-radius:13px 13px 3px 13px}
.bubble.recv{background:var(--elevated);border:1px solid var(--bdr);color:var(--tx2);border-radius:13px 13px 13px 3px}
.bubble.sys{background:rgba(168,85,247,.07);border:1px solid rgba(168,85,247,.15);color:var(--purple);margin:0 auto;font-size:.7rem;text-align:center;border-radius:9px;padding:5px 12px;max-width:90%}
.msg-in-row{padding:10px;border-top:1px solid var(--bdr);display:flex;gap:8px;align-items:center}
.msg-in{flex:1;background:var(--elevated);border:1px solid var(--bdr);border-radius:18px;padding:8px 13px;font-family:'Satoshi',sans-serif;font-size:.78rem;color:var(--tx);outline:none}
.msg-in:focus{border-color:var(--gold-b)}
.typing{display:flex;gap:3px;align-items:center;padding:8px 12px;background:var(--elevated);border:1px solid var(--bdr);border-radius:13px 13px 13px 3px;width:fit-content}
.tdot{width:5px;height:5px;background:var(--tx3);border-radius:50%;animation:td .7s ease-in-out infinite}
.tdot:nth-child(2){animation-delay:.12s}
.tdot:nth-child(3){animation-delay:.24s}
@keyframes td{0%,60%,100%{transform:translateY(0)}30%{transform:translateY(-4px)}}

/* AI */
.ai-wrap{background:var(--card);border:1px solid var(--bdr);border-radius:var(--r);overflow:hidden}
.ai-head{padding:12px 16px;border-bottom:1px solid var(--bdr);display:flex;align-items:center;gap:9px;background:linear-gradient(90deg,rgba(212,168,67,.06),transparent)}
.ai-msgs{height:320px;overflow-y:auto;padding:14px;display:flex;flex-direction:column;gap:9px}
.ai-msg-row{display:flex;gap:8px;align-items:flex-start}
.ai-msg-row.user{flex-direction:row-reverse}
.ai-bub{padding:8px 12px;border-radius:11px;font-size:.78rem;line-height:1.6;max-width:82%}
.ai-bub.user{background:var(--gold-dim);border:1px solid var(--gold-b);color:var(--tx);border-radius:11px 11px 3px 11px}
.ai-bub.bot{background:var(--elevated);border:1px solid var(--bdr);color:var(--tx2);border-radius:11px 11px 11px 3px}
.ai-sugs{display:flex;gap:6px;flex-wrap:wrap;padding:0 14px 10px}
.ai-sug{padding:4px 11px;background:var(--elevated);border:1px solid var(--bdr);border-radius:20px;font-size:.7rem;cursor:pointer;color:var(--tx2);transition:all .2s}
.ai-sug:hover{border-color:var(--gold-b);color:var(--gold)}
.ai-in-row{padding:10px;border-top:1px solid var(--bdr);display:flex;gap:8px}
.ai-in{flex:1;background:var(--elevated);border:1px solid var(--bdr);border-radius:18px;padding:8px 12px;font-family:'Satoshi',sans-serif;font-size:.78rem;color:var(--tx);outline:none}
.ai-in:focus{border-color:var(--gold-b)}

/* MODAL */
.overlay{position:fixed;inset:0;background:rgba(0,0,0,.72);backdrop-filter:blur(4px);z-index:200;display:flex;align-items:center;justify-content:center;opacity:0;pointer-events:none;transition:opacity .22s;padding:16px}
.overlay.open{opacity:1;pointer-events:all}
.modal{background:var(--card);border:1px solid var(--bdr2);border-radius:18px;width:100%;max-width:500px;max-height:88vh;overflow-y:auto;transform:translateY(18px);transition:transform .28s ease;box-shadow:0 20px 60px rgba(0,0,0,.7)}
.overlay.open .modal{transform:translateY(0)}
.modal-lg{max-width:620px}
.mh{padding:20px 20px 0;display:flex;align-items:flex-start;justify-content:space-between;gap:10px}
.m-title{font-family:'Fraunces',serif;font-size:1.2rem;font-weight:600}
.m-sub{font-size:.72rem;color:var(--tx3);margin-top:2px}
.m-close{width:28px;height:28px;background:var(--elevated);border:1px solid var(--bdr);border-radius:50%;display:flex;align-items:center;justify-content:center;cursor:pointer;font-size:.85rem;color:var(--tx3);flex-shrink:0;transition:all .2s}
.m-close:hover{background:var(--hover);color:var(--tx)}
.mb{padding:16px 20px 20px}
.mf{padding:0 20px 20px;display:flex;gap:8px;justify-content:flex-end}
.m-steps{display:flex;gap:4px;margin-bottom:16px}
.m-step{flex:1;height:3px;background:var(--elevated);border-radius:100px;transition:background .3s}
.m-step.done{background:var(--gold)}
.sum-row{display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid var(--bdr);font-size:.8rem}
.sum-row:last-child{border-bottom:none}
.sum-val{font-weight:600}
.star-row{display:flex;gap:6px}
.star-row span{font-size:1.6rem;cursor:pointer;opacity:.3;transition:all .15s}
.star-row span.on{opacity:1}
.star-row span:hover{transform:scale(1.15)}

/* AVATARS */
.av{border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:700;flex-shrink:0;color:#fff;text-shadow:0 1px 2px rgba(0,0,0,.4)}
.av-xs{width:24px;height:24px;font-size:.6rem}
.av-sm{width:30px;height:30px;font-size:.7rem}
.av-md{width:38px;height:38px;font-size:.85rem}
.av-lg{width:52px;height:52px;font-size:1.1rem}
.av-xl{width:68px;height:68px;font-size:1.4rem}
.av-sarah{background:linear-gradient(135deg,#8B5CF6,#EC4899);box-shadow:0 3px 10px rgba(139,92,246,.3)}
.av-mike{background:linear-gradient(135deg,#3B82F6,#1D4ED8);box-shadow:0 3px 10px rgba(59,130,246,.3)}
.av-sara{background:linear(135deg,#10B981,#047857);background:linear-gradient(135deg,#10B981,#047857);box-shadow:0 3px 10px rgba(16,185,129,.3)}
.av-daniel{background:linear-gradient(135deg,#F59E0B,#D97706);box-shadow:0 3px 10px rgba(245,158,11,.3)}
.av-priya{background:linear-gradient(135deg,#EC4899,#BE185D);box-shadow:0 3px 10px rgba(236,72,153,.3)}
.av-james{background:linear-gradient(135deg,#6366F1,#4338CA);box-shadow:0 3px 10px rgba(99,102,241,.3)}
.av-rob{background:linear-gradient(135deg,#EF4444,#B91C1C);box-shadow:0 3px 10px rgba(239,68,68,.3)}
.av-ai{background:linear-gradient(135deg,#d4a843,#b8832a);box-shadow:0 3px 10px rgba(212,168,67,.35)}

/* HEALTH */
.h-ring{position:relative;width:110px;height:110px;flex-shrink:0}
.h-ring svg{transform:rotate(-90deg)}
.h-score{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center}
.h-val{font-family:'Fraunces',serif;font-size:1.7rem;font-weight:600;color:var(--gold);line-height:1}
.h-lbl{font-size:.6rem;color:var(--tx3);margin-top:1px}
.h-bar{height:4px;background:rgba(255,255,255,.06);border-radius:100px;overflow:hidden}
.h-fill{height:100%;border-radius:100px}

/* TOAST */
.toasts{position:fixed;bottom:72px;left:50%;transform:translateX(-50%);z-index:1000;display:flex;flex-direction:column;gap:6px;align-items:center;pointer-events:none}
.toast{background:var(--elevated);border:1px solid var(--bdr2);border-radius:18px;padding:8px 16px;font-size:.78rem;color:var(--tx);display:flex;align-items:center;gap:7px;box-shadow:0 6px 24px rgba(0,0,0,.5);animation:tin .25s ease,tout .25s ease 2.6s forwards;white-space:nowrap}
@keyframes tin{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
@keyframes tout{from{opacity:1}to{opacity:0;transform:translateY(8px)}}

/* NOTIF PANEL */
.notif-panel{position:fixed;top:60px;right:16px;width:320px;background:var(--card);border:1px solid var(--bdr2);border-radius:var(--r);box-shadow:0 12px 40px rgba(0,0,0,.6);z-index:150;display:none;overflow:hidden}
.notif-panel.open{display:block;animation:fi .2s ease}
.notif-item{padding:12px 14px;border-bottom:1px solid var(--bdr);display:flex;gap:9px;align-items:flex-start;cursor:pointer;transition:background .15s}
.notif-item:hover{background:var(--hover)}
.notif-item.unread{background:rgba(212,168,67,.04)}
.notif-dot-unread{width:7px;height:7px;background:var(--gold);border-radius:50%;flex-shrink:0;margin-top:5px}
.notif-dot-read{width:7px;height:7px;background:transparent;flex-shrink:0;margin-top:5px}

/* PROFILE PAGE */
.profile-hero{background:var(--card);border:1px solid var(--bdr);border-radius:var(--r);padding:26px;margin-bottom:18px;position:relative;overflow:hidden}
.profile-hero::before{content:'';position:absolute;top:0;left:0;right:0;height:65px;background:linear-gradient(180deg,rgba(212,168,67,.06),transparent)}
.p-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--bdr);border-radius:var(--rs);overflow:hidden;margin-top:18px}
.p-stat{background:var(--elevated);padding:12px;text-align:center}
.p-stat-v{font-family:'Fraunces',serif;font-size:1.25rem;font-weight:600}
.p-stat-l{font-size:.66rem;color:var(--tx3);margin-top:1px}

/* SETTINGS */
.settings-sec{background:var(--card);border:1px solid var(--bdr);border-radius:var(--r);overflow:hidden;margin-bottom:16px}
.settings-row{display:flex;align-items:center;justify-content:space-between;padding:13px 16px;border-bottom:1px solid var(--bdr)}
.settings-row:last-child{border-bottom:none}
.s-lbl{font-size:.84rem;font-weight:500}
.s-sub{font-size:.7rem;color:var(--tx3);margin-top:1px}
.toggle{position:relative;width:38px;height:21px;cursor:pointer}
.toggle input{opacity:0;width:0;height:0}
.tslider{position:absolute;inset:0;background:var(--elevated);border:1px solid var(--bdr);border-radius:20px;transition:all .3s}
.tslider::before{content:'';position:absolute;left:3px;bottom:3px;width:13px;height:13px;background:var(--tx3);border-radius:50%;transition:all .3s}
.toggle input:checked+.tslider{background:var(--gold-dim);border-color:var(--gold-b)}
.toggle input:checked+.tslider::before{left:18px;background:var(--gold)}

/* FEED */
.feed-item{display:flex;gap:10px;padding:10px 0;border-bottom:1px solid var(--bdr)}
.feed-item:last-child{border-bottom:none}
.fdot{width:7px;height:7px;border-radius:50%;flex-shrink:0;margin-top:4px}
.ftxt{font-size:.78rem;color:var(--tx2);line-height:1.5}
.ftxt strong{color:var(--tx)}
.ftime{font-size:.66rem;color:var(--tx3);margin-top:2px}

/* BENCH */
.bench{background:var(--elevated);border:1px solid var(--bdr);border-radius:var(--rs);padding:12px;margin-top:9px}
.bench-bar{height:5px;background:rgba(255,255,255,.06);border-radius:100px;position:relative;margin:8px 0 3px}
.bench-fill{height:100%;background:linear-gradient(90deg,var(--green),var(--gold));border-radius:100px}
.bench-mark{position:absolute;top:-4px;width:12px;height:12px;background:white;border-radius:50%;border:2px solid var(--gold);transform:translateX(-50%)}

/* SCROLLBAR */
::-webkit-scrollbar{width:4px;height:4px}
::-webkit-scrollbar-track{background:transparent}
::-webkit-scrollbar-thumb{background:rgba(255,255,255,.08);border-radius:10px}
::-webkit-scrollbar-thumb:hover{background:rgba(255,255,255,.13)}

/* RESPONSIVE */
@media(max-width:1100px){.stats-grid{grid-template-columns:repeat(2,1fr)}.g3{grid-template-columns:1fr 1fr}.g4{grid-template-columns:repeat(2,1fr)}}
@media(max-width:900px){.g2{grid-template-columns:1fr}.msg-wrap{grid-template-columns:1fr}.msg-list{display:none}}
@media(max-width:768px){
  #auth-screen{align-items:flex-start;padding:12px}
  .auth-box{max-height:calc(100vh - 24px);padding:22px 18px;margin:0 auto}
  .sidebar{transform:translateX(-100%)}.sidebar.open{transform:translateX(0)}
  .bnav{display:block}.main{margin-left:0;padding-bottom:65px}
  .page{padding:14px 12px}.topbar{padding:0 12px}
  .stats-grid{grid-template-columns:repeat(2,1fr);gap:9px}
  .overlay{align-items:flex-end;padding:0}.modal{border-radius:18px 18px 0 0;max-width:100%}
  .toasts{bottom:80px;left:10px;right:10px;transform:none}.toast{white-space:normal}
  .notif-panel{right:8px;width:calc(100vw - 16px)}
}

/* ══ PROPERTY MANAGER ══ */
.prop-check-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:8px;margin-bottom:12px}
</style>
</head>
<body>

<!-- ═══════════ AUTH SCREEN ═══════════ -->
<div id="auth-screen">
  <div class="auth-box">
    <div class="auth-logo">
      <div class="auth-logo-mark">🛡️</div>
      <div class="auth-logo-text">Trade<span>Shield</span></div>
    </div>

    <div class="auth-tabs">
      <div class="auth-tab active" onclick="switchAuthTab('login')">Sign In</div>
      <div class="auth-tab" onclick="switchAuthTab('signup')">Create Account</div>
    </div>

    <!-- LOGIN -->
    <div id="auth-login">
      <div class="fg">
        <label class="fl">Email</label>
        <input type="email" class="fi" id="login-email" placeholder="your@email.com">
        <div class="err-msg" id="login-email-err"></div>
      </div>
      <div class="fg">
        <label class="fl">Password</label>
        <input type="password" class="fi" id="login-pass" placeholder="••••••••">
        <div class="err-msg" id="login-pass-err"></div>
      </div>
      <div class="err-msg" id="login-err" style="margin-bottom:10px;text-align:center"></div>
      <button class="btn btn-p btn-full" onclick="doLogin()" style="margin-top:4px">Sign In</button>
    </div>

    <!-- SIGNUP -->
    <div id="auth-signup" style="display:none">
      <div class="auth-role-pick">
        <div class="role-card selected" id="role-client" onclick="pickRole('client')">
          <span class="role-emoji">🏠</span>
          <div class="role-label">I'm a Client</div>
          <div class="role-sub">I need tradespeople</div>
        </div>
        <div class="role-card" id="role-trade" onclick="pickRole('trade')">
          <span class="role-emoji">🔧</span>
          <div class="role-label">I'm a Tradesperson</div>
          <div class="role-sub">I offer services</div>
        </div>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
        <div class="fg"><label class="fl">First Name</label><input type="text" class="fi" id="su-first" placeholder="First name"><div class="err-msg" id="su-first-err"></div></div>
        <div class="fg"><label class="fl">Last Name</label><input type="text" class="fi" id="su-last" placeholder="Last name"><div class="err-msg" id="su-last-err"></div></div>
      </div>
      <div class="fg"><label class="fl">Email</label><input type="email" class="fi" id="su-email" placeholder="your@email.com"><div class="err-msg" id="su-email-err"></div></div>
      <div class="fg"><label class="fl">Password</label><input type="password" class="fi" id="su-pass" placeholder="Min 8 characters"><div class="err-msg" id="su-pass-err"></div></div>
      <div id="su-trade-fields" style="display:none">
        <div class="fg">
          <label class="fl">Trade Type</label>
          <select class="fi" id="su-trade-type" onchange="updateCertOptions()">
            <option value="">Select your trade…</option>
            <option value="Electrician">Electrician</option>
            <option value="Gas Engineer">Gas Engineer</option>
            <option value="Plumber">Plumber</option>
            <option value="Builder">Builder</option>
            <option value="Decorator">Decorator</option>
            <option value="Gardener">Gardener</option>
            <option value="Cleaner">Cleaner</option>
            <option value="Carpenter">Carpenter</option>
            <option value="Roofer">Roofer</option>
            <option value="Plasterer">Plasterer</option>
            <option value="Tiler">Tiler</option>
            <option value="Locksmith">Locksmith</option>
            <option value="HVAC Engineer">HVAC Engineer</option>
            <option value="Solar/Renewables">Solar/Renewables</option>
            <option value="General Maintenance">General Maintenance</option>
          </select>
        </div>
        <div class="fg" id="su-cert-wrap" style="display:none">
          <label class="fl">Certifications</label>
          <div id="su-certs-list" style="display:flex;flex-direction:column;gap:8px;margin-bottom:8px"></div>
          <button type="button" class="btn btn-s btn-sm" onclick="addCertRow()" id="su-add-cert-btn" style="display:none">＋ Add Another Certification</button>
          <div style="font-size:.68rem;color:var(--tx3);margin-top:6px">We verify all registration numbers against official registers. Your profile shows ✓ Verified once confirmed — usually within 24hrs.</div>
        </div>
        <div class="fg">
          <label class="fl">Years Experience</label>
          <input type="number" class="fi" id="su-exp" placeholder="e.g. 8" min="0" max="50">
        </div>
        <div class="fg">
          <label class="fl">Hourly Rate (optional)</label>
          <input type="text" class="fi" id="su-rate" placeholder="e.g. £45/hr">
        </div>
        <div style="background:var(--elevated);border:1px solid var(--bdr);border-radius:var(--rs);padding:10px 12px;font-size:.72rem;color:var(--tx3);margin-bottom:8px">
          🔒 <strong style="color:var(--tx)">Identity verification:</strong> We manually verify all certification numbers against official registers before approving your profile. This protects clients and builds trust in the platform.
        </div>
      </div>
      <div class="fg"><label class="fl">Postcode</label><input type="text" class="fi" id="su-post" placeholder="e.g. N1 2AB"></div>
      <div class="err-msg" id="su-err" style="margin-bottom:10px;text-align:center"></div>
      <div style="display:flex;align-items:flex-start;gap:8px;margin-bottom:11px;padding:10px;background:var(--elevated);border-radius:var(--rs);border:1px solid var(--bdr)">
        <input type="checkbox" id="terms-agree" style="margin-top:2px;accent-color:var(--gold);width:14px;height:14px;flex-shrink:0">
        <label for="terms-agree" style="font-size:.72rem;color:var(--tx2);line-height:1.5;cursor:pointer">I have read and agree to the <span style="color:var(--gold);cursor:pointer;text-decoration:underline" onclick="openModal('termsModal')">Terms of Service</span>, <span style="color:var(--gold);cursor:pointer;text-decoration:underline" onclick="openModal('termsModal')">Privacy Policy</span> and <span style="color:var(--gold);cursor:pointer;text-decoration:underline" onclick="openModal('termsModal')">Contractor Agreement</span>. I understand that TradeShield is a marketplace platform and that all tradespeople are independent self-employed contractors.</label>
      </div>
      <div class="err-msg" id="terms-err" style="text-align:center;margin-bottom:8px"></div>
      <button class="btn btn-p btn-full" onclick="doSignup()">Create Account — It's Free</button>
    </div>
  </div>
</div>

<!-- ═══════════ APP ═══════════ -->
<div class="app" id="app">

  <!-- SIDEBAR -->
  <aside class="sidebar" id="sidebar">
    <div class="sidebar-logo">
      <div class="logo-mark">🛡️</div>
      <div class="logo-text">Trade<span>Shield</span></div>
    </div>
    <nav class="sidebar-nav" id="sidebar-nav">
      <!-- populated by JS based on role -->
    </nav>
    <div class="sidebar-footer" onclick="navigate('profile')">
      <div class="av av-sm av-sarah" id="sidebar-av">SC</div>
      <div style="flex:1;min-width:0">
        <div style="font-size:.78rem;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis" id="sidebar-name">Sarah Clarke</div>
        <div style="font-size:.68rem;color:var(--tx3)" id="sidebar-role">Client · Gold Tier</div>
      </div>
      <div style="color:var(--tx3);font-size:.75rem">›</div>
    </div>
  </aside>

  <!-- MAIN -->
  <main class="main" id="main-content">
    <header class="topbar">
      <div style="display:flex;align-items:center;gap:12px">
        <button class="tbtn" id="menu-btn" onclick="toggleSidebar()" style="display:none">☰</button>
        <div class="topbar-title" id="page-title">Dashboard</div>
      </div>
      <div class="topbar-right">
        <div class="tbtn gold" id="topbar-primary-btn" onclick="openModal('postJob')">📝 Post a Job</div>
        <div class="tbtn" onclick="navigate('messages')">💬 Messages</div>
        <div class="tbtn" id="theme-btn" onclick="toggleTheme()" title="Theme">🌙</div>
        <div class="tbtn" onclick="navigate('global')" title="Region">🌍 <span id="locale-flag">🇬🇧</span></div>
        <div class="tbtn" onclick="toggleNotifs()" style="position:relative">
          🔔 <span id="notif-count-badge" style="display:none;position:absolute;top:-3px;right:-3px;width:16px;height:16px;background:var(--red);border-radius:50%;font-size:.58rem;font-weight:700;color:white;align-items:center;justify-content:center">0</span>
        </div>
        <div class="av av-sm av-sarah" id="topbar-av" onclick="navigate('profile')" style="cursor:pointer">SC</div>
      </div>
    </header>

    <!-- ═══ PAGES ═══ -->

    <!-- DASHBOARD -->
    <section class="page active" id="page-dashboard">
      <div id="dash-stats" class="stats-grid"></div>

      <!-- PLAN STATUS BANNER -->
      <div id="dash-plan-banner" style="margin-bottom:16px"></div>


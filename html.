// FEATURE 5: EMAIL REMINDERS (local scheduling)
// Full server-side reminders need Supabase cron
// This tracks what reminders are due and shows them
// ══════════════════════════════════════════════════════

function checkReminders() {
  if (!currentUser) return;
  const props = typeof getProperties === 'function' ? getProperties() : [];
  const recurring = typeof getRecurring === 'function' ? getRecurring() : [];
  const now = new Date();
  const reminders = [];

  // Check property certificates
  props.forEach(prop => {
    (prop.checks||[]).forEach(ch => {
      if (!ch.dueDate) return;
      const due = new Date(ch.dueDate);
      const days = Math.round((due-now)/(1000*60*60*24));
      if (days < 0) reminders.push({type:'cert', urgent:true, msg:`⚠️ ${ch.type} at ${prop.name} is OVERDUE`, action:'properties'});
      else if (days <= 30) reminders.push({type:'cert', urgent:days<=7, msg:`📋 ${ch.type} at ${prop.name} due in ${days} days`, action:'properties'});
    });
  });

  // Check recurring jobs
  recurring.forEach(r => {
    const next = new Date(r.nextDate);
    const days = Math.round((next-now)/(1000*60*60*24));
    if (days < 0) reminders.push({type:'recurring', urgent:true, msg:`⚠️ ${r.desc} is overdue`, action:'recurring'});
    else if (days <= 7) reminders.push({type:'recurring', urgent:false, msg:`🔄 ${r.desc} due in ${days} days`, action:'recurring'});
  });

  if (reminders.length) {
    // Show urgent ones as toasts
    const urgent = reminders.filter(r=>r.urgent).slice(0,2);
    urgent.forEach((r,i) => setTimeout(()=>toast(r.msg), i*1500));
    // Update notification badge
    const badge = document.getElementById('nb');
    if (badge) badge.textContent = reminders.length;
  }
}



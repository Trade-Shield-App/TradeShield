  const stars  = reviewsRecv.map(r=>r.stars||r.rating||0).filter(s=>s>0);
  const avg    = stars.length?(stars.reduce((a,b)=>a+b,0)/stars.length).toFixed(1):null;
  const jd     = currentUser.joined_at||currentUser.joinedAt;
  const since  = jd?new Date(jd).toLocaleDateString('en-GB',{month:'short',year:'numeric'}):new Date().toLocaleDateString('en-GB',{month:'short',year:'numeric'});
  const av     = (currentUser.av||(currentUser.first||'?')[0]).toUpperCase();

      const { data:tradeRows } = await sb.from('users').select('*').eq('role','trade').order('created_at',{ascending:false});
      TRADES_DATA.length = 0;
      (tradeRows || []).forEach(u => {
        const tradeType = u.trade_type || u.tradeType || 'Tradesperson';
        const av = u.av || ((u.first_name||u.name||'T').slice(0,1) + ((u.last_name||'').slice(0,1))).toUpperCase();

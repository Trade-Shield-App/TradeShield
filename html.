async function doLogin() {
  clearErrors();
  const email = document.getElementById('login-email').value.trim();
  const pass  = document.getElementById('login-pass').value;
  if (!email) { showErr('login-email-err','Email required'); return; }
  if (!pass)  { showErr('login-pass-err','Password required'); return; }
  if (SB_READY) {
    const btn = document.querySelector('#auth-login .btn-p');
    if (btn) { btn.textContent='Signing in…'; btn.disabled=true; }
    const { data, error } = await sb.auth.signInWithPassword({ email, password: pass });
    if (btn) { btn.textContent='Sign In'; btn.disabled=false; }
    if (error) { showErr('login-err', error.message.includes('Invalid') ? 'Incorrect email or password' : error.message); return; }
    const { data: profile } = await sb.from('users').select('*').eq('id', data.user.id).single();
    if (!profile) { showErr('login-err','Account not found — please sign up'); return; }
    currentUser = profile;
    currentUserArea = currentUser.area || getPostcodeArea(currentUser.postcode || currentUser.location);
    await loadUserData();
    showApp();
    toast('👋 Welcome back, ' + (currentUser.first_name || currentUser.name.split(' ')[0]) + '!');
  } else {
    const user = DEMO_USERS[email];
    if (!user || user.pass !== pass) { showErr('login-err','Invalid email or password'); return; }
    currentUser = user; currentUserArea = currentUser.area || getPostcodeArea(currentUser.postcode || currentUser.location); DB.set('session', email); loadUserData(); showApp();
    toast('👋 Welcome back, ' + currentUser.first + '!');
  }
}

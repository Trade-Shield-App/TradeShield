<style id="ts-hardening-style">
/* launch hardening patch */
[data-page="aiassist"],
#page-aiassist,
[onclick*="aiassist"],
.ai-wrap,
.ai-head,
.ai-msgs,
.ai-sugs,
.ai-in-row{
  display:none !important;
}
</style>
<script id="ts-launch-hardening">
(function(){
  const HIDE_AI = true;

  function safeInitials(first, last, fallback){
    const a = (first || fallback || 'T').trim().charAt(0);
    const b = (last || '').trim().charAt(0);
    return (a + b).toUpperCase() || 'TS';
  }

  function safeName(u){
    if (!u) return 'TradeShield User';
    return u.name || [u.first_name || u.first, u.last_name || u.last].filter(Boolean).join(' ').trim() || 'TradeShield User';
  }

  function safeAvatarClass(role, tradeType){
    if (role === 'trade') {
      const type = String(tradeType || '').toLowerCase();
      if (type.includes('clean')) return 'av-sarah';
      if (type.includes('electric')) return 'av-mike';
      if (type.includes('plumb')) return 'av-mike';
      if (type.includes('builder')) return 'av-daniel';
      return 'av-mike';
    }
    return 'av-sarah';
  }

  function normaliseCurrentUserShape(){
    if (!window.currentUser) return;
    const u = window.currentUser;
    u.first_name = u.first_name || u.first || (u.name ? u.name.split(' ')[0] : '');
    u.last_name = u.last_name || u.last || (u.name ? u.name.split(' ').slice(1).join(' ') : '');
    u.name = safeName(u);
    u.av = u.av || safeInitials(u.first_name, u.last_name, u.name);
    u.avClass = u.avClass || u.av_class || safeAvatarClass(u.role, u.trade_type || u.tradeType);
    u.location = u.location || u.postcode || '';
    u.area = u.area || (typeof getPostcodeArea === 'function' ? getPostcodeArea(u.postcode || u.location || '') : '');
    u.tier = u.tier || (u.role === 'trade' ? 'Provisional' : 'Bronze');
    u.subscription_plan = u.subscription_plan || (u.role === 'trade' ? 'standard' : 'free');
    window.currentUser = u;
  }

  function normaliseJobsArray(){
    if (!Array.isArray(window.jobs)) return;
    window.jobs = window.jobs.map(function(job){
      if (typeof window.normaliseJob === 'function') job = window.normaliseJob(job);
      job = job || {};
      job.title = job.title || 'Untitled job';
      job.trade = job.trade || job.trade_type || 'General';
      job.tradeName = job.tradeName || job.trade_name || 'Tradesperson';
      job.tradeAv = job.tradeAv || job.trade_av || safeInitials(job.tradeName, '', 'T');
      job.tradeCls = job.tradeCls || job.trade_cls || 'av-mike';
      job.status = job.status || 'pending';
      job.date = job.date || new Date().toISOString().split('T')[0];
      job.ref = job.ref || ('TS-' + String(job.id || Date.now()).replace(/\D/g,'').slice(-6));
      job.milestones = Array.isArray(job.milestones) && job.milestones.length ? job.milestones : ['Completion'];
      job.milestonesDone = Number(job.milestonesDone || 0) || 0;
      job.escrow = Number(job.escrow || 0) || 0;
      job.paid = Number(job.paid || 0) || 0;
      return job;
    });
  }

  function scrubUndefinedText(root){
    (root || document).querySelectorAll('*').forEach(function(node){
      if (!node || !node.childNodes || node.childNodes.length !== 1) return;
      const txt = node.textContent;
      if (typeof txt === 'string' && /\bundefined\b/i.test(txt.trim())) {
        node.textContent = txt.replace(/\bundefined\b/gi, '').replace(/\s{2,}/g, ' ').trim();
      }
    });
  }

  function removeAIUI(){
    if (!HIDE_AI) return;
    document.querySelectorAll('[data-page="aiassist"], [onclick*="aiassist"]').forEach(function(el){
      el.style.display = 'none';
    });
    const page = document.getElementById('page-aiassist');
    if (page) page.remove();
    if (window.PAGE_TITLES && window.PAGE_TITLES.aiassist) delete window.PAGE_TITLES.aiassist;
  }

  function fixSavedEmailPlaceholders(){
    document.querySelectorAll('.__cf_email__').forEach(function(el){
      if (window.currentUser && window.currentUser.email) {
        const span = document.createElement('span');
        span.textContent = window.currentUser.email;
        el.replaceWith(span);
      }
    });
  }

  function hardRefreshUI(){
    normaliseCurrentUserShape();
    normaliseJobsArray();
    removeAIUI();
    scrubUndefinedText(document);
    fixSavedEmailPlaceholders();
  }

  window.showTradeProfile = function(tradeId){
    try {
      if (typeof navigate === 'function') navigate('find');
      setTimeout(function(){
        var target = document.querySelector('[data-trade-id="' + tradeId + '"]');
        if (!target) {
          target = Array.from(document.querySelectorAll('#trades-grid .card, #map-trade-cards .card')).find(function(el){
            return String(el.innerHTML || '').indexOf(tradeId) >= 0;
          });
        }
        if (target) {
          target.scrollIntoView({behavior:'smooth', block:'center'});
          const oldBorder = target.style.borderColor;
          const oldShadow = target.style.boxShadow;
          target.style.borderColor = 'var(--gold)';
          target.style.boxShadow = '0 0 0 2px rgba(212,168,67,.25)';
          setTimeout(function(){
            target.style.borderColor = oldBorder;
            target.style.boxShadow = oldShadow;
          }, 2500);
        } else if (typeof toast === 'function') {
          toast('👤 Trade profile opened in directory');
        }
      }, 60);
    } catch (e) {
      console.warn('showTradeProfile fallback failed', e);
    }
  };

  if (typeof window.navigate === 'function') {
    const _navigate = window.navigate;
    window.navigate = function(page){
      if (page === 'aiassist' && HIDE_AI) {
        if (typeof toast === 'function') toast('ℹ️ Support tools are not enabled in this launch build');
        page = 'dashboard';
      }
      const out = _navigate.apply(this, arguments.length ? [page] : arguments);
      setTimeout(hardRefreshUI, 0);
      return out;
    };
  }

  if (typeof window.updateTopbar === 'function') {
    const _updateTopbar = window.updateTopbar;
    window.updateTopbar = function(){
      normaliseCurrentUserShape();
      const out = _updateTopbar.apply(this, arguments);
      try {
        const av = document.getElementById('topbar-av');
        const sav = document.getElementById('sidebar-av');
        if (av && window.currentUser) {
          av.textContent = window.currentUser.av;
          av.className = 'av av-sm ' + window.currentUser.avClass;
        }
        if (sav && window.currentUser) {
          sav.textContent = window.currentUser.av;
          sav.className = 'av av-sm ' + window.currentUser.avClass;
        }
      } catch(e){}
      return out;
    };
  }

  if (typeof window.showApp === 'function') {
    const _showApp = window.showApp;
    window.showApp = function(){
      normaliseCurrentUserShape();
      const out = _showApp.apply(this, arguments);
      hardRefreshUI();
      return out;
    };
  }

  if (typeof window.loadUserData === 'function') {
    const _loadUserData = window.loadUserData;
    window.loadUserData = async function(){
      normaliseCurrentUserShape();
      const out = await _loadUserData.apply(this, arguments);
      normaliseJobsArray();
      return out;
    };
  }

  if (typeof window.renderAllPages === 'function') {
    const _renderAllPages = window.renderAllPages;
    window.renderAllPages = function(){
      hardRefreshUI();
      const out = _renderAllPages.apply(this, arguments);
      setTimeout(hardRefreshUI, 0);
      return out;
    };
  }

  if (typeof window.renderTrades === 'function') {
    const _renderTrades = window.renderTrades;
    window.renderTrades = function(){
      const out = _renderTrades.apply(this, arguments);
      document.querySelectorAll('#trades-grid .card, #map-trade-cards .card').forEach(function(card){
        if (!card.dataset.tradeId) {
          const match = (card.innerHTML || '').match(/showTradeProfile\('([^']+)'\)/);
          if (match) card.dataset.tradeId = match[1];
        }
      });
      scrubUndefinedText(document.getElementById('page-find') || document);
      return out;
    };
  }

  if (typeof window.renderMessages === 'function') {
    const _renderMessages = window.renderMessages;
    window.renderMessages = function(){
      const out = _renderMessages.apply(this, arguments);
      scrubUndefinedText(document.getElementById('page-messages') || document);
      return out;
    };
  }

  if (typeof window.buildSidebar === 'function') {
    const _buildSidebar = window.buildSidebar;
    window.buildSidebar = function(){
      const out = _buildSidebar.apply(this, arguments);
      removeAIUI();
      return out;
    };
  }

  if (typeof window.sendAI === 'function') {
    window.askAI = function(){
      if (typeof toast === 'function') toast('ℹ️ Support tools are not enabled in this launch build');
    };
    window.sendAI = function(){
      if (typeof toast === 'function') toast('ℹ️ Support tools are not enabled in this launch build');
      const input = document.getElementById('ai-in');
      if (input) input.value = '';
    };
  }

  async function restoreSession(){
    try {
      if (window.currentUser) return;
      if (typeof SB_READY !== 'undefined' && SB_READY && window.sb && sb.auth) {
        const sess = await sb.auth.getSession();
        const userId = sess && sess.data && sess.data.session && sess.data.session.user && sess.data.session.user.id;
        if (userId) {
          const profileRes = await sb.from('users').select('*').eq('id', userId).maybeSingle();
          if (profileRes && profileRes.data) {
            window.currentUser = profileRes.data;
            if (typeof loadUserData === 'function') await loadUserData();
            if (typeof showApp === 'function') showApp();
            return;
          }
        }
      }
      if (typeof DB !== 'undefined') {
        const demoEmail = DB.get('session', null);
        if (demoEmail && window.DEMO_USERS && DEMO_USERS[demoEmail]) {
          window.currentUser = DEMO_USERS[demoEmail];
          if (typeof loadUserData === 'function') await loadUserData();
          if (typeof showApp === 'function') showApp();
        }
      }
    } catch (e) {
      console.warn('Session restore skipped:', e);
    }
  }

  window.addEventListener('error', function(ev){
    console.error('TradeShield runtime error:', ev.error || ev.message);
  });

  window.addEventListener('unhandledrejection', function(ev){
    console.error('TradeShield async error:', ev.reason);
  });

  window.addEventListener('load', function(){
    hardRefreshUI();
    restoreSession();
  });

  setTimeout(hardRefreshUI, 50);
})();
</script>

<style id="ts-final-launch-style">
[data-page="aiassist"],#page-aiassist,[onclick*="aiassist"],.ai-wrap,.ai-head,.ai-msgs,.ai-sugs,.ai-in-row{display:none !important;}
</style>
<script id="ts-final-launch-script">
(function(){
  function after(ms, fn){ setTimeout(fn, ms||0); }
  function safeText(v, fb){ return (v===undefined || v===null || v==='undefined') ? (fb||'') : String(v); }

  function applyLaunchCopy(){
    var pageTitleMap = {
      'insurance-coming-title':'Protection Roadmap'
    };
    Object.keys(pageTitleMap).forEach(function(id){
      var el = document.getElementById(id);
      if (el) el.textContent = pageTitleMap[id];
    });
    var bookDesc = document.getElementById('book-desc');
    if (bookDesc && /AI will scope it/i.test(bookDesc.placeholder || '')) {
      bookDesc.placeholder = 'Describe the job clearly and include anything a tradesperson should know before quoting.';
    }
    var stripePh = document.getElementById('stripe-card-placeholder');
    if (stripePh && /will appear here/i.test(stripePh.textContent || '')) {
      stripePh.textContent = 'Secure Stripe card entry loads below when payment is ready.';
    }
  }

  function removeAIEverywhere(){
    document.querySelectorAll('[data-page="aiassist"], [onclick*="aiassist"]').forEach(function(el){ el.style.display='none'; });
    var page = document.getElementById('page-aiassist');
    if (page) page.remove();
    if (window.PAGE_TITLES) delete window.PAGE_TITLES.aiassist;
  }

  function scrubUndefined(root){
    (root || document).querySelectorAll('*').forEach(function(node){
      if (!node || !node.childNodes || node.childNodes.length !== 1) return;
      if (node.children && node.children.length) return;
      var txt = node.textContent;
      if (typeof txt === 'string' && /\bundefined\b/i.test(txt)) {
        node.textContent = txt.replace(/\bundefined\b/gi,'').replace(/\s{2,}/g,' ').trim();
      }
    });
  }

  function getLeadStatus(lead){
    return String((lead && lead.status) || '').toLowerCase();
  }

  function eligibleTradeLeads(){
    var leads = Array.isArray(window.tradeLeads) ? window.tradeLeads.slice() : [];
    return leads.filter(function(j){
      var s = getLeadStatus(j);
      return ['pending','open','new'].includes(s) || !s;
    });
  }

  if (typeof window.renderQuotes === 'function') {
    var _renderQuotes = window.renderQuotes;
    window.renderQuotes = function(){
      if (window.currentUser && window.currentUser.role === 'trade') {
        var el = document.getElementById('quotes-list');
        var headingEl = document.getElementById('quotes-page-heading');
        var subheadingEl = document.getElementById('quotes-page-subheading');
        if (headingEl) headingEl.textContent = 'Lead Inbox';
        if (subheadingEl) subheadingEl.textContent = 'Open client requests matched to your trade. Review details and send a professional quote.';
        if (!el) return;
        var leads = eligibleTradeLeads();
        if (!leads.length) {
          el.innerHTML = '<div class="card" style="text-align:center;padding:44px"><div style="font-size:2.5rem;margin-bottom:12px">📋</div><div style="font-family:Fraunces,serif;font-size:1.1rem;margin-bottom:8px">No open leads right now</div><div style="font-size:.8rem;color:var(--tx3);margin-bottom:20px;max-width:420px;margin-left:auto;margin-right:auto">New client requests will appear here automatically when they match your trade and area.</div><button class="btn btn-s" onclick="navigate(\'jobs\')">View Leads & Jobs</button></div>';
          return;
        }
        el.innerHTML = leads.map(function(lead){
          var quoteRequest = (typeof ensureQuoteRequestFromLead === 'function') ? ensureQuoteRequestFromLead(lead.id) : null;
          var myQuote = quoteRequest && Array.isArray(quoteRequest.quotes) ? quoteRequest.quotes.find(function(qu){ return qu.tradeId === window.currentUser.id; }) : null;
          var postcode = safeText(lead.postcode || lead.location || lead.area, 'Area to be confirmed');
          var budget = safeText(lead.budget || lead.hourly_rate, 'Budget on request');
          var preferredDate = safeText(lead.date || lead.preferred_date, 'Flexible');
          var postedBy = safeText(lead.client_name, 'Client');
          var summary = safeText(lead.description || lead.desc, 'Client lead ready for quotes.');
          var title = safeText(lead.title, (safeText(lead.trade,'General') + ' job'));
          return '<div class="card" style="margin-bottom:12px"><div style="display:flex;align-items:flex-start;justify-content:space-between;gap:10px;margin-bottom:10px"><div><div style="font-weight:600;font-size:.95rem">'+title+'</div><div style="font-size:.72rem;color:var(--tx3);margin-top:2px">'+safeText(lead.trade,'General')+' · '+postcode+' · '+postedBy+'</div></div><span class="badge bgr">Open Lead</span></div><div style="font-size:.78rem;color:var(--tx2);margin-bottom:12px;line-height:1.6">'+summary+'</div><div style="display:flex;gap:12px;flex-wrap:wrap;font-size:.72rem;color:var(--tx3);margin-bottom:12px"><span>💷 '+budget+'</span><span>📅 '+preferredDate+'</span><span>🆔 '+safeText(lead.ref || lead.id,'Lead')+'</span></div>' + (myQuote ? '<div style="background:var(--gold-dim);border:1px solid var(--gold-b);border-radius:8px;padding:10px;font-size:.78rem"><strong>Your quote: £'+safeText(myQuote.amount,'0')+'</strong>'+(myQuote.duration ? ' · '+myQuote.duration : '')+(myQuote.accepted ? '<span class="badge bgr" style="margin-left:8px">✓ Accepted</span>' : '<span class="badge bb" style="margin-left:8px">Sent</span>')+'</div>' : '<div class="j-actions" style="margin-top:0"><button class="btn btn-p btn-sm" onclick="openLeadQuote(\''+lead.id+'\')">Submit Quote</button><button class="btn btn-s btn-sm" onclick="navigate(\'jobs\')">View Details</button></div>') + '</div>';
        }).join('');
        return;
      }
      return _renderQuotes.apply(this, arguments);
    };
  }

  if (typeof window.buildSidebar === 'function') {
    var _buildSidebar = window.buildSidebar;
    window.buildSidebar = function(){
      var out = _buildSidebar.apply(this, arguments);
      removeAIEverywhere();
      document.querySelectorAll('[data-page="quotes"] .nav-item, .nav-item[data-page="quotes"]').forEach(function(el){
        if (window.currentUser && window.currentUser.role === 'trade') el.innerHTML = '<span class="nav-icon">📋</span>Lead Inbox';
      });
      return out;
    };
  }

  if (typeof window.navigate === 'function') {
    var _navigate = window.navigate;
    window.navigate = function(page){
      if (page === 'aiassist') page = 'messages';
      var out = _navigate.apply(this, [page]);
      after(0, function(){
        removeAIEverywhere();
        applyLaunchCopy();
        scrubUndefined(document);
        if (page === 'quotes' && window.currentUser && window.currentUser.role === 'trade' && typeof window.renderQuotes === 'function') {
          window.renderQuotes();
        }
      });
      return out;
    };
  }

  if (typeof window.toast === 'function') {
    var _toast = window.toast;
    window.toast = function(msg){
      if (typeof msg === 'string') {
        msg = msg.replace(/\s*\(Demo mode\)/gi, '');
        msg = msg.replace(/local fallback mode/gi, 'beta mode');
        msg = msg.replace(/Support tools are not enabled in this launch build/gi, 'Support is available in Messages');
      }
      return _toast.apply(this, [msg]);
    };
  }

  if (typeof window.updateTopbar === 'function') {
    var _updateTopbar = window.updateTopbar;
    window.updateTopbar = function(){
      var out = _updateTopbar.apply(this, arguments);
      var topbarBtn = document.getElementById('topbar-primary-btn');
      var dashBtn = document.getElementById('dashboard-primary-btn');
      if (window.currentUser && window.currentUser.role === 'trade') {
        if (topbarBtn) { topbarBtn.textContent = '📋 View Leads'; topbarBtn.onclick = function(){ navigate('jobs'); }; }
        if (dashBtn) { dashBtn.textContent = '📋 View Leads'; dashBtn.onclick = function(){ navigate('jobs'); }; }
      }
      return out;
    };
  }

  function finalPolish(){
    removeAIEverywhere();
    applyLaunchCopy();
    scrubUndefined(document);
    if (window.currentUser && window.currentUser.role === 'trade') {
      var qTitle = document.getElementById('page-title');
      var navActive = document.querySelector('[data-page="quotes"].active');
      if (navActive) navActive.innerHTML = '<span class="nav-icon">📋</span>Lead Inbox';
      if (qTitle && document.getElementById('page-quotes') && document.getElementById('page-quotes').classList.contains('active')) qTitle.textContent = 'Lead Inbox';
    }
  }

  window.addEventListener('load', function(){ after(0, finalPolish); after(200, finalPolish); after(800, finalPolish); });
  after(20, finalPolish);
})();
</script>

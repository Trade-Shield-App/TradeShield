function renderCalendar() {
  const months=['January','February','March','April','May','June','July','August','September','October','November','December'];
  const t = document.getElementById('cal-title');
  if(t) t.textContent = months[calMonth]+' '+calYear;
  const days=['Mon','Tue','Wed','Thu','Fri','Sat','Sun'];
  const hdr = document.getElementById('cal-day-headers');
  if(hdr) hdr.innerHTML = days.map(d=>`<div style="text-align:center;font-size:.65rem;color:var(--tx3);padding:4px;font-weight:600">${d}</div>`).join('');
  const grid = document.getElementById('cal-grid');
  if (grid && calView==='month') {
    const first = new Date(calYear, calMonth, 1);
    const startDow = (first.getDay()+6)%7;
    const daysInMonth = new Date(calYear, calMonth+1, 0).getDate();
    const today = new Date();
    let html = '';
    for(let i=0;i<startDow;i++) html+=`<div style="min-height:52px"></div>`;
    for(let d=1;d<=daysInMonth;d++) {
      const dateStr = calYear+'-'+String(calMonth+1).padStart(2,'0')+'-'+String(d).padStart(2,'0');
      const dayJobs = calJobs.filter(j=>j.date===dateStr);
      const isToday = today.getFullYear()===calYear&&today.getMonth()===calMonth&&today.getDate()===d;
      html+=`<div style="min-height:52px;background:var(--elevated);border-radius:6px;padding:4px;cursor:pointer;border:1px solid ${isToday?'var(--gold)':'var(--bdr)'};transition:border .2s" onclick="calDayClick('${dateStr}')">
        <div style="font-size:.7rem;font-weight:${isToday?'700':'400'};color:${isToday?'var(--gold)':'var(--tx3)'};margin-bottom:2px">${d}</div>
        ${dayJobs.slice(0,2).map(j=>`<div style="font-size:.58rem;background:${j.color};color:white;border-radius:3px;padding:1px 4px;margin-bottom:1px;overflow:hidden;white-space:nowrap;text-overflow:ellipsis">${j.title}</div>`).join('')}
        ${dayJobs.length>2?`<div style="font-size:.55rem;color:var(--tx3)">+${dayJobs.length-2} more</div>`:''}
      </div>`;
    }
    grid.innerHTML = html;
  }
  if (calView==='week') {
    const wg = document.getElementById('cal-week-grid');
    if (wg) {
      const now2 = new Date(calYear,calMonth,1);
      const weekStart = new Date(now2);
      weekStart.setDate(now2.getDate()-(now2.getDay()+6)%7);
      const weekDays = [];
      for(let i=0;i<7;i++){const d=new Date(weekStart);d.setDate(weekStart.getDate()+i);weekDays.push(d);}
      wg.innerHTML = weekDays.map(d=>{
        const ds=d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');
        const dj=calJobs.filter(j=>j.date===ds);
        return`<div class="card" style="padding:10px"><div style="font-size:.7rem;color:var(--tx3);margin-bottom:6px;font-weight:600">${['Mon','Tue','Wed','Thu','Fri','Sat','Sun'][i]} ${d.getDate()}</div>${dj.length?dj.map(j=>`<div style="background:${j.color};border-radius:6px;padding:6px 8px;margin-bottom:4px"><div style="font-size:.72rem;font-weight:600;color:white">${j.time} — ${j.title}</div><div style="font-size:.62rem;color:rgba(255,255,255,.8)">${j.client}${j.value?` · £${j.value}`:''}</div></div>`).join(''):'<div style="font-size:.7rem;color:var(--tx3);padding:8px 0">Free</div>'}</div>`;
      }).join('');
    }
  }
  renderCalUpcoming();
}

function renderCalUpcoming() {
  const el = document.getElementById('cal-upcoming');
  if (!el) return;
  const today = new Date().toISOString().split('T')[0];
  const upcoming = calJobs.filter(j=>j.date>=today).sort((a,b)=>a.date.localeCompare(b.date)).slice(0,5);

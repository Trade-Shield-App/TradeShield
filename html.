    if (now < unlockTime) {
      const minsLeft = Math.round((unlockTime - now) / 60000);
      const badge = document.createElement('div');
      badge.style.cssText = 'background:var(--gold-dim);border:1px solid var(--gold-b);border-radius:5px;padding:4px 8px;font-size:.68rem;color:var(--gold);margin-top:6px;cursor:pointer';

function handleJobPhoto(input, jobId, jobTitle) {
  const file = input.files[0];
  if (!file) return;
  const type = prompt('Label this photo:', 'Before') || 'Before';
  const reader = new FileReader();
  reader.onload = e => {
    const photos = getJobPhotos();
    photos.push({
      id: 'ph'+Date.now(), jobId, jobTitle,
      type, dataUrl: e.target.result,
      fileName: file.name,
      addedAt: new Date().toISOString()
    });
    saveJobPhotos(photos);
    toast('📸 Photo saved — '+type);
    renderJobPhotos();
  };
  reader.readAsDataURL(file);
  input.value = '';
}

function deleteJobPhoto(photoId) {
  if (!confirm('Delete this photo?')) return;
  const photos = getJobPhotos().filter(p=>p.id!==photoId);

function doPostQuote() {
  const title = document.getElementById('pq-title').value.trim();
  const trade = document.getElementById('pq-trade').value;
  const desc  = document.getElementById('pq-desc').value.trim();
  if (!title) { toast('⚠️ Add a job title'); return; }
  if (!trade) { toast('⚠️ Select a trade type'); return; }
  if (!desc)  { toast('⚠️ Describe the job'); return; }
  const quotes = getQuotes();
  quotes.unshift({
    id: 'qr'+Date.now(), title, trade, desc,
    budget: document.getElementById('pq-budget').value,
    date:   document.getElementById('pq-date').value,
    address:document.getElementById('pq-addr').value.trim(),
    status: 'open', quotes: [],
    clientId: currentUser.id,
    clientName: currentUser.name,

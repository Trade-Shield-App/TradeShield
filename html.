async function doSubscribe(plan) {
  if (!SB_READY) { toast('⚠️ Connect Supabase to enable subscriptions'); return; }
  if (!currentUser?.id) { toast('⚠️ Please sign in first'); return; }

  const btn = document.querySelector(`#sub-cta-trader .btn-p, #sub-cta-landlord .btn-p`);
  if (btn) { btn.textContent = 'Redirecting…'; btn.disabled = true; }

  try {
    const res = await fetch(FUNCTIONS_URL + '/create-subscription', {
      method: 'POST',
      headers: { 'Authorization': 'Bearer ' + SUPABASE_KEY, 'Content-Type': 'application/json' },
      body: JSON.stringify({
        userId:    currentUser.id,
        email:     currentUser.email,
        plan,
        role:      currentUser.role,
        returnUrl: window.location.href,
      })
    });
    const { checkoutUrl, error } = await res.json();
    if (error) throw new Error(error);
    toast('🔄 Redirecting to Stripe Checkout…');
    setTimeout(() => { window.location.href = checkoutUrl; }, 600);
  } catch(e) {
    toast('❌ Subscription error: ' + e.message);
    if (btn) { btn.textContent = 'Subscribe →'; btn.disabled = false; }
  }
}

async function doCancelSubscription() {
  if (!confirm('Cancel your subscription? You\'ll keep access until the end of your billing period.')) return;
  if (!SB_READY) { toast('Cancellation is not available for this booking yet'); return; }

  try {
    const res = await fetch(FUNCTIONS_URL + '/cancel-subscription', {
      method: 'POST',
      headers: { 'Authorization': 'Bearer ' + SUPABASE_KEY, 'Content-Type': 'application/json' },
      body: JSON.stringify({ userId: currentUser.id })
    });
    const { success, message, error } = await res.json();
    if (error) throw new Error(error);
    currentUser.subscription_status = 'cancelled';
    toast('✅ ' + message);
    renderSubscriptionUI();
  } catch(e) {
    toast('❌ ' + e.message);
  }
}

// Check for Stripe subscription return
(function checkSubReturn() {
  const params = new URLSearchParams(window.location.search);
  if (params.get('sub_success') === 'true') {
    const plan = params.get('plan') || '';
    const names = {pro:'Pro',elite:'Elite',essential:'Essential',portfolio:'Portfolio'};
    window.history.replaceState({}, '', window.location.pathname);

    // Update local object immediately so UI reflects plan right away
    if (currentUser && plan) {
      currentUser.subscription_plan   = plan;
      currentUser.subscription_status = 'active';
      currentUser.lead_notify_delay   = 0;
    }

    toast('⏳ Confirming your subscription…');

    // Call verify-subscription to confirm with Stripe and update Supabase
    // This bypasses the webhook entirely — direct Stripe → Supabase activation
    if (SB_READY && currentUser) {
      fetch(FUNCTIONS_URL + '/verify-subscription', {
        method: 'POST',
        headers: { 'Authorization': 'Bearer ' + SUPABASE_KEY, 'Content-Type': 'application/json' },
        body: JSON.stringify({
          userId: currentUser.id,
          email:  currentUser.email,
          role:   currentUser.role,
        })
      })
      .then(r => r.json())
      .then(data => {
        if (data.success && data.plan) {
          // Update local user with confirmed plan from Stripe
          currentUser.subscription_plan   = data.plan;
          currentUser.subscription_status = 'active';
          currentUser.lead_notify_delay   = 0;
          const planName = names[data.plan] || data.plan;
          toast('🎉 ' + planName + ' plan activated! Welcome to TradeShield ' + planName + '.');
          // Refresh subscription UI
          if (typeof renderSubscriptionUI === 'function') renderSubscriptionUI();
          if (typeof buildSidebar === 'function') buildSidebar();
        } else {
          toast('⚠️ Subscription paid but activation delayed — refresh in 30 seconds.');
          console.warn('verify-subscription response:', data);
        }
      })
      .catch(e => {
        toast('✅ Payment confirmed! Refresh the page to see your new plan.');
        console.error('verify-subscription error:', e);
      });
    } else {
      toast('🎉 Welcome to ' + (names[plan]||plan) + '! Your plan is now active.');
    }

  } else if (params.get('sub_cancelled') === 'true') {
    toast('Subscription not completed — you remain on your current plan.');
    window.history.replaceState({}, '', window.location.pathname);
  }
})();

